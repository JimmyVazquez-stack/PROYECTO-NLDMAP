# Copiar a .env en la raíz del despliegue y proteger con chmod 600.
# Etiqueta SHA exacta publicada por GitHub Actions (no usar latest).
IMAGE_TAG=REEMPLAZAR_SHA
SERVER_IMAGE=ghcr.io/jimmyvazquez-stack/nldmap-server
SITE_DOMAIN=REEMPLAZAR_DOMINIO
# Generar cada contraseña de DB con: openssl rand -hex 32
# Usar hex evita caracteres reservados en URI, connection strings y Compose.
POSTGRES_ADMIN_PASSWORD=REEMPLAZAR
POSTGRES_APP_PASSWORD=REEMPLAZAR
MONGO_ROOT_PASSWORD=REEMPLAZAR
MONGO_APP_PASSWORD=REEMPLAZAR
# SMTP es necesario para invitaciones y recuperación; no para iniciar sesión.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=

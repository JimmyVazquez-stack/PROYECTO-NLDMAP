@inherits LayoutComponentBase

@* =========================================
   PROVEEDORES DE MUDBLAZOR
   ========================================= *@

<MudThemeProvider Theme="@_theme"
                  @bind-IsDarkMode="_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


@* =========================================
   ESTRUCTURA PRINCIPAL
   ========================================= *@

<MudLayout>

    @* =====================================
       BARRA SUPERIOR
       ===================================== *@

    <MudAppBar Elevation="1">

        @* Abrir / cerrar menú lateral *@
        <MudIconButton
            Icon="@Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Size="Size.Medium"
            Edge="Edge.Start"
            OnClick="ToggleDrawer"
            aria-label="@(_drawerOpen ? "Cerrar menú" : "Abrir menú")"
            aria-expanded="@_drawerOpen.ToString().ToLowerInvariant()"
            aria-controls="administration-menu" />

        <MudSpacer />

        @* Acciones de la barra superior *@
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="1">

            @* Cambiar tema *@
            <MudTooltip Text="@(_isDarkMode
                                  ? "Activar modo claro"
                                  : "Activar modo oscuro")">

                <MudIconButton
                    Icon="@(_isDarkMode
                        ? Icons.Material.Filled.LightMode
                        : Icons.Material.Filled.DarkMode)"
                    Color="Color.Inherit"
                    Size="Size.Medium"
                    OnClick="ToggleTheme"
                    aria-label="@(_isDarkMode
                        ? "Activar modo claro"
                        : "Activar modo oscuro")" />

            </MudTooltip>


            @* Inicio *@
            <MudTooltip Text="Inicio">

                <MudIconButton
                    Icon="@Icons.Material.Outlined.Home"
                    Href="/admin"
                    Color="Color.Inherit"
                    Size="Size.Medium"
                    aria-label="Inicio de administración" />

            </MudTooltip>


            @* Perfil *@
            <MudTooltip Text="Perfil: próximamente">

                <MudIconButton
                    Icon="@Icons.Material.Outlined.AccountCircle"
                    Color="Color.Inherit"
                    Size="Size.Medium"
                    Disabled="true"
                    aria-label="Perfil, próximamente" />

            </MudTooltip>


            @* Notificaciones *@
            <MudTooltip Text="Notificaciones: próximamente">

                <MudIconButton
                    Icon="@Icons.Material.Outlined.Notifications"
                    Color="Color.Inherit"
                    Size="Size.Medium"
                    Disabled="true"
                    aria-label="Notificaciones, próximamente" />

            </MudTooltip>


            @* Cerrar sesión *@
            <form method="post"
                  action="/Account/Logout"
                  data-enhance="false"
                  class="admin-logout-form">

                <AntiforgeryToken />

                <MudButton
                    ButtonType="ButtonType.Submit"
                    Variant="Variant.Text"
                    Color="Color.Inherit"
                    StartIcon="@Icons.Material.Filled.Logout"
                    aria-label="Cerrar sesión">

                    <span class="admin-logout-text">
                        Cerrar sesión
                    </span>

                </MudButton>

            </form>

        </MudStack>

    </MudAppBar>


    @* =====================================
       MENÚ LATERAL
       ===================================== *@

    <MudDrawer
        id="administration-menu"
        @bind-Open="_drawerOpen"
        Variant="DrawerVariant.Responsive"
        Breakpoint="Breakpoint.Md"
        ClipMode="DrawerClipMode.Never"
        Elevation="1"
        Class="admin-drawer">

        @* =================================
           LOGOTIPO NLDMAP
           ================================= *@

        <MudDrawerHeader Class="admin-drawer-header">

            <div class="admin-brand">

                <div class="admin-brand-icon">

                    <MudText Typo="Typo.h6"
                             Class="admin-brand-letter">
                        N
                    </MudText>

                </div>

                <MudText Typo="Typo.h6"
                         Class="admin-brand-name">
                    LDMAP
                </MudText>

            </div>

        </MudDrawerHeader>


        @* =================================
           NAVEGACIÓN
           ================================= *@

        <nav class="admin-sidebar-nav"
             aria-label="Navegación de administración">

            <MudNavMenu Rounded="true"
                        Margin="Margin.Dense"
                        Class="admin-nav-menu">

                @* Inicio *@
                <MudNavLink
                    Href="/admin"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Outlined.Dashboard">

                    Inicio

                </MudNavLink>


                <AuthorizeView Policy="@PermissionNames.ReportsRead">
                    <MudNavLink Href="/admin/reportes" Icon="@Icons.Material.Outlined.Description">
                        Reportes
                    </MudNavLink>
                </AuthorizeView>

                @* Usuarios *@
                <AuthorizeView Policy="@PermissionNames.UsersRead">

                    <MudNavLink
                        Href="/admin/usuarios"
                        Icon="@Icons.Material.Outlined.People">

                        Usuarios

                    </MudNavLink>

                </AuthorizeView>


                @* Roles y permisos *@
                <AuthorizeView Policy="@PermissionNames.RolesRead">

                    <MudNavLink
                        Href="/admin/roles"
                        Icon="@Icons.Material.Outlined.AdminPanelSettings">

                        Roles y permisos

                    </MudNavLink>

                </AuthorizeView>


                @* Auditoría *@
                <AuthorizeView Policy="@PermissionNames.AuditRead">

                    <MudNavLink
                        Href="/admin/auditoria"
                        Icon="@Icons.Material.Outlined.History">

                        Auditoría

                    </MudNavLink>

                </AuthorizeView>


                @* Invitaciones *@
                <AuthorizeView Policy="@PermissionNames.InvitationsManage">

                    <MudNavLink
                        Href="/admin/invitaciones"
                        Icon="@Icons.Material.Outlined.Mail">

                        Invitaciones

                    </MudNavLink>

                </AuthorizeView>


                @* Catálogos *@
                <AuthorizeView Policy="@PermissionNames.CatalogsRead">

                    <MudNavLink
                        Href="/admin/catalogos"
                        Icon="@Icons.Material.Outlined.Folder">

                        Catálogos

                    </MudNavLink>

                </AuthorizeView>

            </MudNavMenu>

        </nav>

    </MudDrawer>


    @* =====================================
       CONTENIDO PRINCIPAL
       ===================================== *@

    <MudMainContent Class="admin-main-content">

        <MudContainer
            MaxWidth="MaxWidth.ExtraLarge"
            Class="admin-content-container pa-4 pa-md-8">

            <ErrorBoundary>

                <ChildContent>
                    @Body
                </ChildContent>

                <ErrorContent>

                    <MudAlert
                        Severity="Severity.Error"
                        Variant="Variant.Outlined">

                        Ocurrió un error al cargar esta sección.

                        <MudLink Href="/admin"
                                 Color="Color.Error">
                            Recargar administración
                        </MudLink>

                    </MudAlert>

                </ErrorContent>

            </ErrorBoundary>

        </MudContainer>


        @* =================================
           PIE DE PÁGINA
           ================================= *@

        <footer class="admin-footer">

            <MudStack
                Row="true"
                AlignItems="AlignItems.Center"
                Justify="Justify.Center"
                Wrap="Wrap.Wrap"
                Spacing="1">

                <MudText Typo="Typo.subtitle2">
                    <strong>NLDMAP-WEB</strong>
                </MudText>

                <MudText Typo="Typo.body2"
                         Align="Align.Center">

                    Aplicación web para la gestión de reportes
                    de personas no localizadas y desaparecidas

                </MudText>

            </MudStack>

        </footer>

    </MudMainContent>

</MudLayout>
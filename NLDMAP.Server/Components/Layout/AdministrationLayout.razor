@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using NLDMAP.Application.Security
@using MudBlazor

<MudThemeProvider Theme="@_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

   <MudAppBar Color="Color.Primary" Elevation="2">

    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Size="Size.Medium"
                   Edge="Edge.Start"
                   OnClick="ToggleDrawer"
                   aria-label="@(_drawerOpen ? "Cerrar menú" : "Abrir menú")"
                   aria-expanded="@(_drawerOpen ? "true" : "false")"
                   aria-controls="administration-menu" />

    <MudSpacer />

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="1">

        <MudIconButton Icon="@Icons.Material.Outlined.Home"
                       Href="/administracion"
                       Size="Size.Medium"
                       title="Inicio"
                       aria-label="Inicio de administración" />

        <MudIconButton Icon="@Icons.Material.Outlined.AccountCircle"
                       Size="Size.Medium"
                       Disabled="true"
                       Class="mud-text-white"
                       title="Perfil: próximamente"
                       aria-label="Perfil, próximamente" />

        <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                       Size="Size.Medium"
                       Disabled="true"
                       Class="mud-text-white"
                       title="Notificaciones: próximamente"
                       aria-label="Notificaciones, próximamente" />

        <form method="post"
              action="/Account/Logout"
              data-enhance="false"
              class="ma-0">

            <AntiforgeryToken />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Logout"
                       aria-label="Cerrar sesión">

                <span class="d-none d-sm-inline">
                    Cerrar sesión
                </span>

            </MudButton>
        </form>

    </MudStack>

</MudAppBar>
    <MudDrawer id="administration-menu"
               @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Never"
               Elevation="2"
               Style="overflow-y: auto; overflow-x: hidden;"
               Height="100vh">

        <MudDrawerHeader Class="px-4 py-4">
            <MudStack Spacing="1">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="1">

                    <MudPaper Elevation="1"
                              Class="px-2 py-0 rounded-lg"
                              Style="background: transparent; border: 1px solid black;">

                        <MudText Typo="Typo.h6"
                                 Style="color: black; font-weight: 700;">
                            N
                        </MudText>

                    </MudPaper>

                    <MudText Typo="Typo.h6"
                             Class="ml-1"
                             Style="color: black; font-weight: 700;">
                        LDMAP
                    </MudText>

                </MudStack>

             

            </MudStack>
        </MudDrawerHeader>
        
        <nav aria-label="Administración">
            <MudNavMenu Color="Color.Inherit"
                        Rounded="true"
                        Margin="Margin.Dense"
                        Class="pa-3">

                <MudNavLink Href="/administracion"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Outlined.Home"
                            Style="text-decoration: none;">
                    Inicio
                </MudNavLink>

                <AuthorizeView Policy="@PermissionNames.UsersRead">
                    <MudNavLink Href="/administracion/usuarios"
                                Icon="@Icons.Material.Outlined.People"
                                Style="text-decoration: none;">
                        
                        Usuarios
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@PermissionNames.RolesRead">
                    <MudNavLink Href="/administracion/roles"
                                Icon="@Icons.Material.Outlined.AdminPanelSettings"
                                Style="text-decoration: none;">
                        Roles y permisos
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@PermissionNames.AuditRead">
                    <MudNavLink Href="/administracion/auditoria"
                                Icon="@Icons.Material.Outlined.History"
                                Style="text-decoration: none;">
                        Auditoría
                    </MudNavLink>
                </AuthorizeView>

                <AuthorizeView Policy="@PermissionNames.InvitationsManage">
                    <MudNavLink Href="/administracion/invitaciones"
                                Icon="@Icons.Material.Outlined.Mail"
                                Style="text-decoration: none;">
                        Invitaciones
                    </MudNavLink>
                </AuthorizeView>

            </MudNavMenu>
        </nav>

        <MudDivider Class="mx-4 my-2" />

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="1"
                  Class="px-4 pt-5 pb-3">

            <MudText Typo="Typo.subtitle1">
                <strong>NLDMAP</strong>
            </MudText>

            <MudText Typo="Typo.body2" >
                — Administración
            </MudText>

        </MudStack>

    </MudDrawer>
    

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="pa-4 pa-md-8">

            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>

                <ErrorContent>
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined">
                        Ocurrió un error al cargar esta sección.

                        <a href="/administracion"
                           data-enhance-nav="false">
                            Recargar administración
                        </a>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>

        </MudContainer>
    </MudMainContent>

</MudLayout>
@using NLDMAP.Server.Components.Reports.Models

<section class="report-preview" aria-labelledby="preview-heading" tabindex="-1" @ref="panel">
    <div class="preview-heading">
        <h2 id="preview-heading">@Report.Folio · @Report.PersonName</h2>
        <MudButton Variant="Variant.Outlined" OnClick="OnClose" aria-label="Cerrar detalle del reporte">Cerrar</MudButton>
    </div>
    <p><strong>Revisión:</strong> @Report.ReviewStatus · <strong>Publicación:</strong> @Report.PublicationStatus</p>
    <p>@Report.Description</p>
    <p class="preview-note">Vista de ejemplo. La revisión, edición y publicación se implementarán posteriormente.</p>
</section>

@code {
    [Parameter, EditorRequired] public ReportInboxRow Report { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference panel;
    private Guid? focusedReport;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusedReport != Report.Id) { focusedReport = Report.Id; await panel.FocusAsync(); }
    }
}

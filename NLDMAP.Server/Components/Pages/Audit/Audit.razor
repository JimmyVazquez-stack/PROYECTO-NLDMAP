@page "/admin/auditoria"
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.AuditRead)]
@inherits AdminPageBase
@using System.Text.Json

<PageTitle>Auditoría | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Auditoría administrativa</MudText>
        <MudText Typo="Typo.body2">Consulta quién realizó cada cambio. Fechas y horas en UTC.</MudText>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Consultando auditoría" />
    }

    <MudPaper Class="pa-4" Elevation="1">
        <EditForm Model="filters" OnValidSubmit="SearchAsync" FormName="audit-filters">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Responsable" Variant="Variant.Outlined"
                                  @bind-Value="filters.Actor" MaxLength="100"
                                  Immediate="true" Disabled="Busy" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Operación" Placeholder="Todas" Variant="Variant.Outlined"
                               @bind-Value="filters.Operation" Disabled="Busy">
                        <MudSelectItem T="string" Value="@string.Empty">Todas</MudSelectItem>
                        @foreach (var operation in operations)
                        {
                            <MudSelectItem T="string" Value="@operation">@operation</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Cuenta, rol o identificador" Variant="Variant.Outlined"
                                  @bind-Value="filters.Target" MaxLength="100"
                                  Immediate="true" Disabled="Busy" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Desde (UTC)" Variant="Variant.Outlined"
                                   @bind-Date="filters.From" Clearable="true" Disabled="Busy" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Hasta (UTC, incluido)" Variant="Variant.Outlined"
                                   @bind-Date="filters.To" Clearable="true" Disabled="Busy" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Primary" Disabled="Busy">
                        Consultar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>

    @if (entries is not null)
    {
        <MudTable T="AuditRow" Items="entries.Items" Context="entry"
                  Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1">
            <HeaderContent>
                <MudTh>Fecha UTC</MudTh>
                <MudTh>Responsable</MudTh>
                <MudTh>Operación</MudTh>
                <MudTh>Registro afectado</MudTh>
                <MudTh>Detalle</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha UTC">@entry.Date.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                <MudTd DataLabel="Responsable">@entry.Actor</MudTd>
                <MudTd DataLabel="Operación">@entry.Operation</MudTd>
                <MudTd DataLabel="Registro afectado">@entry.TargetName</MudTd>
                <MudTd DataLabel="Detalle">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Disabled="Busy" OnClick="() => selected = entry">
                        Ver cambios
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">No hay movimientos con estos filtros.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudStack Row="true" AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">@entries.Total resultados</MudText>
            @if (entries.TotalPages > 1)
            {
                <MudPagination Count="entries.TotalPages" Selected="entries.Page"
                               SelectedChanged="ChangePageAsync" Disabled="Busy" Color="Color.Primary" />
            }
        </MudStack>
    }

    @if (selected is { } detail)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Movimiento #@detail.Id</MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               OnClick="() => selected = null">
                        Cerrar detalle
                    </MudButton>
                </MudStack>
                <MudText Typo="Typo.body2">@detail.TargetType · @detail.TargetId</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.subtitle2" HtmlTag="h3">Antes</MudText>
                        <MudPaper Outlined="true" Class="pa-3">
                            <pre style="margin: 0; white-space: pre-wrap; overflow-wrap: anywhere;">@Pretty(detail.BeforeJson)</pre>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" lg="6">
                        <MudText Typo="Typo.subtitle2" HtmlTag="h3">Después</MudText>
                        <MudPaper Outlined="true" Class="pa-3">
                            <pre style="margin: 0; white-space: pre-wrap; overflow-wrap: anywhere;">@Pretty(detail.AfterJson)</pre>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private sealed class Filters
    {
        public string Actor { get; set; } = "";
        public string Operation { get; set; } = "";
        public string Target { get; set; } = "";
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
    }

    private static readonly string[] operations =
    [
        "User.ProfileUpdated", "User.StatusChanged", "User.RolesChanged", "User.PasswordReset",
        "Role.Created", "Role.Updated", "Role.Deleted",
        "Invitation.Created", "Invitation.Resent", "Invitation.Revoked", "Invitation.Accepted"
    ];

    private static readonly JsonSerializerOptions indentedJson = new() { WriteIndented = true };
    private readonly Filters filters = new();
    private AuditQuery appliedQuery = new();
    private PageResult<AuditRow>? entries;
    private AuditRow? selected;

    protected override Task LoadAsync() => LoadEntriesAsync(appliedQuery);

    private async Task LoadEntriesAsync(AuditQuery query)
    {
        entries = await Admin.GetAuditAsync(query);
        appliedQuery = query;
        selected = null;
    }

    private Task SearchAsync() => RunAsync(() =>
    {
        var from = Utc(filters.From);
        var to = Utc(filters.To);
        if (from.HasValue && to.HasValue && from.Value > to.Value)
            throw new AdministrationException("La fecha Desde no puede ser posterior a la fecha Hasta.");

        // El límite superior de la consulta es exclusivo.
        var toExclusive = to == Utc(DateTime.MaxValue.Date) ? null : to?.AddDays(1);
        return LoadEntriesAsync(new AuditQuery(filters.Actor, filters.Operation, filters.Target,
                                              from, toExclusive));
    });

    private Task ChangePageAsync(int page) =>
        RunAsync(() => LoadEntriesAsync(appliedQuery with { Page = page }));

    private static DateTimeOffset? Utc(DateTime? date) =>
        date.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc)) : null;

    private static string Pretty(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, indentedJson);
        }
        catch (JsonException)
        {
            return json;
        }
    }
}

@page "/administracion/auditoria"
@rendermode InteractiveServer
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.AuditRead)]
@inherits AdminPageBase
<PageTitle>Auditoría | NLDMAP</PageTitle>
<h1 class="h2">Auditoría administrativa</h1>
<p class="text-body-secondary">Consulta quién realizó cada cambio. Fechas y horas en UTC.</p>
<OperationStatus Error="@Error" Notice="@Notice" Busy="Busy" />
<EditForm Model="filters" OnValidSubmit="SearchAsync" FormName="audit-filters" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label for="audit-actor" class="form-label">Responsable</label><InputText id="audit-actor" class="form-control" @bind-Value="filters.Actor" maxlength="100" /></div>
        <div class="col-md-4"><label for="audit-operation" class="form-label">Operación</label><InputSelect id="audit-operation" class="form-select" @bind-Value="filters.Operation"><option value="">Todas</option>@foreach (var op in operations) { <option value="@op">@op</option> }</InputSelect></div>
        <div class="col-md-4"><label for="audit-target" class="form-label">Cuenta, rol o identificador</label><InputText id="audit-target" class="form-control" @bind-Value="filters.Target" maxlength="100" /></div>
        <div class="col-md-4"><label for="audit-from" class="form-label">Desde (UTC)</label><InputDate id="audit-from" class="form-control" @bind-Value="filters.From" /></div>
        <div class="col-md-4"><label for="audit-to" class="form-label">Hasta (UTC, incluido)</label><InputDate id="audit-to" class="form-control" @bind-Value="filters.To" /></div>
        <div class="col-md-4"><button type="submit" class="btn btn-primary" disabled="@Busy">Consultar</button></div>
    </div>
</EditForm>
@if (entries is not null)
{
    <div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Fecha UTC</th><th>Responsable</th><th>Operación</th><th>Registro afectado</th><th>Detalle</th></tr></thead><tbody>
    @foreach (var e in entries.Items)
    {
        <tr><td class="text-nowrap small">@e.Date.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@e.Actor</td><td class="small">@e.Operation</td><td>@e.TargetName</td><td><button class="btn btn-outline-primary btn-sm" @onclick="() => selected = e">Ver cambios</button></td></tr>
    }
    @if (entries.Items.Count == 0) { <tr><td colspan="5" class="text-center py-5 text-body-secondary">No hay movimientos con estos filtros.</td></tr> }
    </tbody></table></div><Pager Page="entries.Page" Pages="entries.TotalPages" Total="entries.Total" Busy="Busy" Changed="ChangePageAsync" /></div>
}
@if (selected is not null)
{
    <section class="card card-body mt-4"><div class="d-flex justify-content-between gap-3"><h2 class="h5">Movimiento #@selected.Id</h2><button class="btn btn-outline-secondary btn-sm" @onclick="() => selected = null">Cerrar detalle</button></div><p class="small text-body-secondary">@selected.TargetType · @selected.TargetId</p><div class="row g-3"><div class="col-lg-6"><h3 class="h6">Antes</h3><pre class="p-3 bg-body-tertiary border rounded text-wrap">@Pretty(selected.BeforeJson)</pre></div><div class="col-lg-6"><h3 class="h6">Después</h3><pre class="p-3 bg-body-tertiary border rounded text-wrap">@Pretty(selected.AfterJson)</pre></div></div></section>
}
@code {
    private sealed class Filters { public string Actor { get; set; } = ""; public string Operation { get; set; } = ""; public string Target { get; set; } = ""; public DateTime? From { get; set; } public DateTime? To { get; set; } }
    private Filters filters = new();
    private PageResult<AuditRow>? entries;
    private AuditRow? selected;
    private int page = 1;
    private readonly string[] operations = ["User.ProfileUpdated", "User.StatusChanged", "User.RolesChanged", "User.PasswordReset", "Role.Created", "Role.Updated", "Role.Deleted", "Invitation.Created", "Invitation.Resent", "Invitation.Revoked", "Invitation.Accepted"];
    protected override async Task LoadAsync() => entries = await Admin.GetAuditAsync(new(filters.Actor, filters.Operation, filters.Target, Utc(filters.From), Utc(filters.To?.AddDays(1)), page));
    private static DateTimeOffset? Utc(DateTime? date) => date.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc)) : null;
    private Task SearchAsync() => RunAsync(async () => { page = 1; selected = null; await LoadAsync(); });
    private Task ChangePageAsync(int value) => RunAsync(async () => { page = value; selected = null; await LoadAsync(); });
    private static string Pretty(string json) => System.Text.Json.JsonSerializer.Serialize(System.Text.Json.JsonDocument.Parse(json).RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
}

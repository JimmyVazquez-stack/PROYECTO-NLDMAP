@page "/"
@page "/inicio"
@layout MainLayout
@attribute [AllowAnonymous]
@using NLDMAP.Server.Theming

<PageTitle>Inicio | Búsqueda Tlaxcala</PageTitle>

<MudThemeProvider Theme="@theme" IsDarkMode="false" />

<div class="public-home">
    <header class="public-header">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            <nav aria-label="Navegación pública">
                <MudStack Row="true" AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                    <MudLink Href="/" Typo="Typo.h6" Underline="Underline.Hover"
                             Class="public-brand">
                        Búsqueda Tlaxcala
                    </MudLink>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
                        <MudLink Href="/" Underline="Underline.Hover" Class="public-link">
                            Inicio
                        </MudLink>
                        <MudLink Href="#quienes-somos" Underline="Underline.Hover" Class="public-link">
                            Quiénes somos
                        </MudLink>
                        <AuthorizeView>
                            <Authorized>
                                <AuthorizeView Policy="@PermissionNames.Access" Context="staff">
                                    <Authorized>
                                        <MudLink Href="/admin" Underline="Underline.Hover" Class="public-link">Administración</MudLink>
                                    </Authorized>
                                    <NotAuthorized>
                                        <MudLink Href="/cuenta/perfil" Underline="Underline.Hover" Class="public-link">Mi cuenta</MudLink>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </Authorized>
                            <NotAuthorized>
                                <MudLink Href="/cuenta/entrar" Underline="Underline.Hover" Class="public-link">
                                    Iniciar sesión
                                </MudLink>
                                <MudButton Href="/cuenta/registro" Variant="Variant.Filled" Color="Color.Primary"
                                           Class="public-register">Crear cuenta</MudButton>
                            </NotAuthorized>
                        </AuthorizeView>
                    </MudStack>
                </MudStack>
            </nav>
        </MudContainer>
    </header>

    <main>
        <section class="public-hero" aria-labelledby="inicio-titulo">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudText id="inicio-titulo" Typo="Typo.h2" HtmlTag="h1" Class="public-title">
                    Búsqueda Tlaxcala
                </MudText>
                <MudText Typo="Typo.body1" HtmlTag="p" Class="public-lead">
                    Crea un reporte, consulta el mapa o revisa tus reportes.
                </MudText>

                <AuthorizeView>
                    <Authorized>
                        @ActionLinks("/reportes/crear", "/reportes/mis-reportes")
                    </Authorized>
                    <NotAuthorized>
                        @ActionLinks("/cuenta/entrar", "/cuenta/entrar")
                    </NotAuthorized>
                </AuthorizeView>
            </MudContainer>
        </section>

        <section id="quienes-somos" class="public-about" aria-labelledby="proyecto-titulo">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudGrid Spacing="4">
                    <MudItem xs="12" lg="4">
                        <MudText Typo="Typo.overline" Class="public-eyebrow">El proyecto</MudText>
                        <MudText id="proyecto-titulo" Typo="Typo.h4" HtmlTag="h2">
                            Quiénes somos
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" lg="8">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6" HtmlTag="p">
                                Búsqueda Tlaxcala es un proyecto orientado a reunir información
                                relacionada con la búsqueda de personas en Tlaxcala.
                            </MudText>
                            <MudText Typo="Typo.body1" Class="public-muted">
                                Estamos construyendo un espacio que permita acercar información
                                clara y accesible a la ciudadanía.
                            </MudText>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        </section>
    </main>

    <footer class="public-footer">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween"
                      Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.subtitle2"><strong>Búsqueda Tlaxcala</strong></MudText>
                <MudText Typo="Typo.body2" Class="public-muted">Tlaxcala, México</MudText>
            </MudStack>
        </MudContainer>
    </footer>
</div>

@code {
    private RenderFragment ActionLinks(string crear, string misReportes) => @<nav class="public-actions" aria-label="Acciones de reportes">
        <a href="@crear" class="public-action public-action-primary">
            <span class="public-action-icon"><MudIcon Icon="@Icons.Material.Outlined.PostAdd" aria-hidden="true" /></span>
            <span>Crear reporte nuevo</span>
        </a>
        <a href="/mapa" class="public-action">
            <span class="public-action-icon"><MudIcon Icon="@Icons.Material.Outlined.Map" aria-hidden="true" /></span>
            <span>Ver el mapa</span>
        </a>
        <a href="@misReportes" class="public-action">
            <span class="public-action-icon"><MudIcon Icon="@Icons.Material.Outlined.FolderOpen" aria-hidden="true" /></span>
            <span>Ver mis reportes</span>
        </a>
    </nav>;

    private readonly MudTheme theme = NldmapTheme.CreatePublic();
}

@page "/admin/catalogos"
@rendermode InteractiveServer
@layout AdministrationLayout
@namespace NLDMAP.Server.Components.Pages.Catalogs
@attribute [Authorize(Policy = PermissionNames.CatalogsRead)]
@inherits AdminPageBase
@using NLDMAP.Application.Security

<PageTitle>Catálogos | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">Catálogos</MudText>

    <MudGrid Spacing="3">
        @foreach (var catalogo in Catalogos)
        {
            <MudItem xs="12" sm="6" lg="4">
                @if (catalogo.Disponible)
                {
                    <a href="@catalogo.Ruta"
                       style="display: block; height: 100%; color: inherit; text-decoration: none;">
                        <MudCard Elevation="1" Style="height: 100%;">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" HtmlTag="h2">
                                    @catalogo.Nombre
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    @catalogo.Descripcion
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </a>
                }
                else
                {
                    <a href="@catalogo.Ruta"
                       style="display: block; height: 100%; color: inherit; text-decoration: none;">
                    <MudCard Elevation="1" Style="height: 100%;">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" HtmlTag="h2">
                                @catalogo.Nombre
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @catalogo.Descripcion
                            </MudText>
                            <MudText Typo="Typo.caption">En preparación</MudText>
                        </MudCardContent>
                    </MudCard>
                    </a>
                }
            </MudItem>
        }
    </MudGrid>
</MudStack>
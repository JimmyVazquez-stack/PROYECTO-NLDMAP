@page "/admin/invitaciones"
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.InvitationsManage)]
@inherits AdminPageBase

<PageTitle>Invitaciones | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Invitaciones</MudText>
        <MudText Typo="Typo.body2">
            El personal define su contraseña mediante un enlace de uso único.
        </MudText>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (!string.IsNullOrEmpty(Notice))
    {
        <MudAlert Severity="Severity.Success" role="status">@Notice</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Procesando invitaciones" />
    }

    @if (CanAssignRoles)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <EditForm Model="input" OnValidSubmit="InviteAsync" FormName="invitation" @key="input">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Invitar personal</MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="5">
                            <MudTextField T="string" Label="Nombre" Variant="Variant.Outlined"
                                          @bind-Value="input.DisplayName" For="() => input.DisplayName"
                                          MaxLength="120" Immediate="true" Disabled="Busy" />
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudTextField T="string" Label="Correo" Variant="Variant.Outlined"
                                          InputType="MudBlazor.InputType.Email"
                                          @bind-Value="input.Email" For="() => input.Email"
                                          MaxLength="256" Immediate="true" Disabled="Busy" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudNumericField T="int" Label="Vigencia (días)" Variant="Variant.Outlined"
                                             @bind-Value="input.ValidDays" For="() => input.ValidDays"
                                             Min="1" Max="7" Disabled="Busy" />
                        </MudItem>
                    </MudGrid>

                    <div>
                        <MudText Typo="Typo.subtitle1" HtmlTag="h3">Roles iniciales</MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            @foreach (var role in roles.Where(role => !RoleNames.IsCitizenRole(role.Name)))
                            {
                                <MudCheckBox T="bool" Label="@role.Name" Color="Color.Primary"
                                             Value="@selected.Contains(role.Id)"
                                             ValueChanged="@(value => Toggle(role.Id, value))"
                                             Disabled="Busy" @key="role.Id" />
                            }
                        </MudStack>
                    </div>

                    <div>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                   Color="Color.Primary" Disabled="Busy">
                            Enviar invitación
                        </MudButton>
                    </div>
                </MudStack>
            </EditForm>
        </MudPaper>
    }

    @if (revoking is not null)
    {
        <MudAlert Severity="Severity.Warning">
            <MudStack Spacing="2">
                <MudText>¿Revocar la invitación de @revoking.Email?</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               Disabled="Busy" OnClick="RevokeAsync">
                        Confirmar revocación
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="Busy"
                               OnClick="() => revoking = null">
                        Cancelar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudAlert>
    }

    <MudTable T="InvitationRow" Items="invitations" Hover="true"
              Breakpoint="Breakpoint.Sm" Elevation="1" Context="invitation">
        <ToolBarContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">Últimas 100 invitaciones</MudText>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Destinatario</MudTh>
            <MudTh>Vence (UTC)</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Entrega</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Destinatario">
                <MudText Typo="Typo.subtitle2">@invitation.DisplayName</MudText>
                <MudText Typo="Typo.caption">@invitation.Email</MudText>
            </MudTd>
            <MudTd DataLabel="Vence (UTC)">@invitation.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Estado">@invitation.Status</MudTd>
            <MudTd DataLabel="Entrega">@invitation.DeliveryStatus</MudTd>
            <MudTd DataLabel="Acciones">
                @if (invitation.Status is "Pendiente" or "Vencida")
                {
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        @if (CanAssignRoles)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       Disabled="Busy" OnClick="() => ResendAsync(invitation.Id)">
                                Reenviar
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   Disabled="Busy" OnClick="() => revoking = invitation">
                            Revocar
                        </MudButton>
                    </MudStack>
                }
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">@(Busy ? "Cargando invitaciones…" : "Todavía no hay invitaciones.")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private InvitationInput input = new();
    private IReadOnlyList<RoleRow> roles = [];
    private IReadOnlyList<InvitationRow> invitations = [];
    private readonly HashSet<string> selected = [];
    private InvitationRow? revoking;

    private bool CanAssignRoles => Access?.Allows(PermissionNames.RolesAssign) == true;

    protected override async Task LoadAsync()
    {
        roles = await Admin.GetRolesAsync();
        invitations = await Admin.GetInvitationsAsync();
    }

    private void Toggle(string id, bool value)
    {
        if (value)
            selected.Add(id);
        else
            selected.Remove(id);
    }

    private Task InviteAsync()
    {
        if (!CanAssignRoles)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            input.RoleIds = selected.ToArray();
            var message = await Admin.InviteAsync(input);
            input = new();
            selected.Clear();
            await LoadAsync();
            SetNotice(message);
        });
    }

    private Task ResendAsync(Guid id)
    {
        if (!CanAssignRoles)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            var message = await Admin.ResendInvitationAsync(id);
            await LoadAsync();
            SetNotice(message);
        });
    }

    private Task RevokeAsync()
    {
        if (revoking is not { } invitation)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await Admin.RevokeInvitationAsync(invitation.Id);
            revoking = null;
            await LoadAsync();
        }, "Invitación revocada.");
    }
}

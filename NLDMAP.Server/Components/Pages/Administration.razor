@page "/admin"
@rendermode InteractiveServer
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.Access)]
@inherits AdminPageBase

<PageTitle>Administración | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">
            Administración del sistema
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Gestiona las cuentas, los accesos, los catálogos y el historial de cambios.
        </MudText>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (!string.IsNullOrEmpty(Notice))
    {
        <MudAlert Severity="Severity.Success" role="status">@Notice</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Cargando administración" />
    }

    @if (Access is { } access)
    {
        <MudText Typo="Typo.body2">Sesión: <strong>@access.Name</strong></MudText>

        <MudGrid Spacing="3">
            @foreach (var module in modules.Where(module => access.Allows(module.Permission)))
            {
                <MudItem xs="12" sm="6" lg="4">
                    <a href="@module.Url"
                       style="display: block; height: 100%; color: inherit; text-decoration: none;">
                        <MudCard Elevation="1" Style="height: 100%;">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" HtmlTag="h2">
                                    @module.Name
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    @module.Description
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </a>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private static readonly (string Name, string Description, string Url, string Permission)[] modules =
    [
        ("Usuarios", "Consulta perfiles, estados y roles.",
            "/admin/usuarios", PermissionNames.UsersRead),

        ("Roles y permisos", "Define qué puede realizar cada rol.",
            "/admin/roles", PermissionNames.RolesRead),

        ("Auditoría", "Revisa responsables y cambios registrados.",
            "/admin/auditoria", PermissionNames.AuditRead),

        ("Invitaciones", "Incorpora personal con enlaces temporales.",
            "/admin/invitaciones", PermissionNames.InvitationsManage),

        ("Catálogos", "Consulta y administra las opciones que se usan en los reportes.",
            "/admin/catalogos", PermissionNames.CatalogsRead)
    ];
}

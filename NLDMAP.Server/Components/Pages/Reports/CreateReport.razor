@page "/reportes/crear"
@layout ReportLayout
@attribute [Authorize(Policy = PermissionNames.ReportsCreate)]
@using NLDMAP.Domain.Catalogs
@using NLDMAP.Application.Reports

<PageTitle>Crear reporte nuevo | Búsqueda Tlaxcala</PageTitle>

<MudPopoverProvider />
<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" HtmlTag="h1">Crear reporte nuevo</MudText>
        @if (folio is null)
        {
            <MudText>Escribe los datos que conozcas. Puedes dejar en blanco los campos opcionales.</MudText>
        }
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert">@error</MudAlert>
        }

        @if (loading || saving)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Procesando reporte" />
        }
        @if (loading)
        {
            <MudText>Cargando catálogos…</MudText>
        }
        else if (folio is not null)
        {
            <MudAlert Severity="Severity.Success" role="status">Reporte guardado. Folio: <strong>@folio</strong></MudAlert>
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton Href="/reportes/mis-reportes" Color="Color.Primary" Variant="Variant.Filled">Ver mis reportes</MudButton>
                <MudButton Href="/">Volver al inicio</MudButton>
            </MudStack>
        }
        else if (options is { } catalog && reporter is { } account)
        {
            <MudPaper Outlined="true" Class="pa-3 pa-sm-5">
                <MudStepper @bind-ActiveIndex="activeStep" OnPreviewInteraction="BeforeStepAsync"
                            ShowResetButton="false" ScrollableNavigation="true">
                    <ChildContent>
                        <MudStep Title="Persona">
                            <MudStack Spacing="3" Class="py-4">
                                <MudGrid>
                                    <MudItem xs="12" sm="4"><MudTextField T="string" Label="Nombre(s)" @bind-Value="input.Nombres" Immediate="true" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                    <MudItem xs="12" sm="4"><MudTextField T="string" Label="Primer apellido" @bind-Value="input.PrimerApellido" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                    <MudItem xs="12" sm="4"><MudTextField T="string" Label="Segundo apellido" @bind-Value="input.SegundoApellido" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudTextField T="string" Label="CURP de la persona reportada" @bind-Value="input.Curp" Immediate="true" MaxLength="18" Variant="Variant.Outlined" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudDatePicker Label="Fecha de nacimiento" @bind-Date="input.FechaNacimiento" MaxDate="@DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Clearable="true" /></MudItem>
                                </MudGrid>
                                <OptionalReportFields Label="apodos" @bind-Added="hasAliases" OnRemove="@(() => input.Apodos = null)">
                                    <MudTextField T="string" Label="Apodos" @bind-Value="input.Apodos"
                                                  Immediate="true" MaxLength="120" Variant="Variant.Outlined" />
                                </OptionalReportFields>
                                <OptionalReportFields Label="otros datos personales" @bind-Added="hasPersonalDetails" OnRemove="ClearPersonalDetails">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6"><ReportCatalogSelect Label="Sexo" Options="catalog.Sexos" @bind-Value="input.SexoId" /></MudItem>
                                        <MudItem xs="12" sm="6"><ReportCatalogSelect Label="Orientación sexual" Options="catalog.Orientaciones" @bind-Value="input.OrientacionSexualId" /></MudItem>
                                        <MudItem xs="12" sm="6"><ReportCatalogSelect Label="Nacionalidad" Options="catalog.Nacionalidades" @bind-Value="input.NacionalidadId" /></MudItem>
                                        <MudItem xs="12" sm="6"><ReportCatalogSelect Label="Ocupación" Options="catalog.Ocupaciones" @bind-Value="input.OcupacionId" /></MudItem>
                                    </MudGrid>
                                </OptionalReportFields>
                                <MudText Typo="Typo.h6">Rasgos físicos y vestimenta</MudText>
                                <MudGrid>
                                    <MudItem xs="12" sm="4">
                                        <MudNumericField T="int?" Label="Estatura (cm)" @bind-Value="input.EstaturaCm"
                                                         Placeholder="Ej. 170" HideSpinButtons="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <ReportCatalogSelect Label="Tez" Options="catalog.Tonos" @bind-Value="input.TezId" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <ReportCatalogSelect Label="Complexión" Options="catalog.Complexiones" @bind-Value="input.ComplexionId" />
                                    </MudItem>
                                </MudGrid>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle1">Cabello</MudText>
                                    @if (input.Cabello is { } cabello)
                                    {
                                        <MudPaper @key="cabello" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="2">
                                                <ReportCatalogSelect Label="Tipo de cabello" Options="catalog.TiposCabello" @bind-Value="cabello.TipoId" />
                                                @if (cabello.TipoId.HasValue)
                                                {
                                                    <MudTextField T="string" Label="Detalle del cabello (opcional)" @bind-Value="cabello.Detalle"
                                                                  Placeholder="Ej. teñido de morado" Immediate="true" MaxLength="@ReportInput.TraitDetailMaxLength" Variant="Variant.Outlined" />
                                                }
                                                <MudButton Class="align-self-start" Size="Size.Small" OnClick="@(() => input.Cabello = null)">Quitar tipo de cabello</MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                    else
                                    {
                                        <MudButton Class="align-self-start" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                                   Disabled="@(catalog.TiposCabello.Count == 0)" OnClick="@(() => input.Cabello = new())">Agregar tipo de cabello</MudButton>
                                    }
                                </MudStack>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle1">Calzado</MudText>
                                    @if (input.Calzado is { } calzado)
                                    {
                                        <MudPaper @key="calzado" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="2">
                                                <ReportCatalogSelect Label="Tipo de calzado" Options="catalog.TiposCalzado" @bind-Value="calzado.TipoId" />
                                                @if (calzado.TipoId.HasValue)
                                                {
                                                    <MudTextField T="string" Label="Detalle del calzado (opcional)" @bind-Value="calzado.Detalle"
                                                                  Placeholder="Ej. tenis blancos con agujetas rojas" Immediate="true" MaxLength="@ReportInput.TraitDetailMaxLength" Variant="Variant.Outlined" />
                                                }
                                                <MudButton Class="align-self-start" Size="Size.Small" OnClick="@(() => input.Calzado = null)">Quitar tipo de calzado</MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                    else
                                    {
                                        <MudButton Class="align-self-start" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                                   Disabled="@(catalog.TiposCalzado.Count == 0)" OnClick="@(() => input.Calzado = new())">Agregar tipo de calzado</MudButton>
                                    }
                                </MudStack>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle1">Ropa</MudText>
                                    @foreach (var prenda in input.Prendas)
                                    {
                                        <MudPaper @key="prenda" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="2">
                                                <ReportCatalogSelect Label="Tipo de prenda" Options="catalog.TiposPrenda" @bind-Value="prenda.TipoId" />
                                                @if (prenda.TipoId.HasValue)
                                                {
                                                    <MudTextField T="string" Label="Detalle de la prenda (opcional)" @bind-Value="prenda.Detalle"
                                                                  Placeholder="Ej. negra con franjas blancas" Immediate="true" MaxLength="@ReportInput.TraitDetailMaxLength" Variant="Variant.Outlined" />
                                                }
                                                <MudButton Class="align-self-start" Size="Size.Small" OnClick="@(() => input.Prendas.Remove(prenda))">Quitar prenda</MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                    <MudButton Class="align-self-start" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="@(catalog.TiposPrenda.Count == 0)" OnClick="@(() => input.Prendas.Add(new()))">Agregar prenda</MudButton>
                                </MudStack>
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle1">Señas particulares</MudText>
                                    @foreach (var sena in input.Senas)
                                    {
                                        <MudPaper @key="sena" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="2">
                                                <ReportCatalogSelect Label="Tipo de seña particular" Options="catalog.TiposSena" @bind-Value="sena.TipoId" />
                                                @if (sena.TipoId.HasValue)
                                                {
                                                    <ReportCatalogSelect Label="Región corporal (opcional)" Options="catalog.RegionesCorporales" @bind-Value="sena.RegionId" />
                                                    <MudTextField T="string" Label="Detalle de la seña (opcional)" @bind-Value="sena.Detalle"
                                                                  Placeholder="Ej. tatuaje con diseño de rosa" Immediate="true" MaxLength="@ReportInput.TraitDetailMaxLength" Variant="Variant.Outlined" />
                                                }
                                                <MudButton Class="align-self-start" Size="Size.Small" OnClick="@(() => input.Senas.Remove(sena))">Quitar seña</MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                    <MudButton Class="align-self-start" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="@(catalog.TiposSena.Count == 0)" OnClick="@(() => input.Senas.Add(new()))">Agregar seña</MudButton>
                                </MudStack>
                                <OptionalReportFields Label="discapacidades" @bind-Added="hasDisabilities" OnRemove="@(() => input.DiscapacidadesIds = [])"
                                                      Disabled="@(catalog.Discapacidades.Count == 0)">
                                    <MudSelect T="Guid" Label="Discapacidades" Variant="Variant.Outlined" Clearable="true"
                                               MultiSelection="true" @bind-SelectedValues="input.DiscapacidadesIds" ToStringFunc="DisabilityName">
                                        @foreach (var disability in catalog.Discapacidades)
                                        {
                                            <MudSelectItem T="Guid" Value="disability.Id">@disability.Nombre</MudSelectItem>
                                        }
                                    </MudSelect>
                                </OptionalReportFields>
                            </MudStack>
                        </MudStep>

                        <MudStep Title="Hechos">
                            <MudStack Spacing="3" Class="py-4">
                                <OptionalReportFields Label="circunstancia" @bind-Added="hasCircumstance" OnRemove="@(() => input.CircunstanciaId = null)" Disabled="@(catalog.Circunstancias.Count == 0)">
                                    <ReportCatalogSelect Label="Circunstancia" Options="catalog.Circunstancias" @bind-Value="input.CircunstanciaId" />
                                </OptionalReportFields>
                                <OptionalReportFields Label="fechas u hora" @bind-Added="hasIncidentDates" OnRemove="ClearIncidentDates">
                                    <MudGrid>
                                        <MudItem xs="12" sm="4"><MudDatePicker Label="Fecha de los hechos" @bind-Date="input.FechaHechos" MaxDate="@DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Clearable="true" /></MudItem>
                                        <MudItem xs="12" sm="4"><MudTimePicker Label="Hora de los hechos" @bind-Time="input.HoraHechos" Variant="Variant.Outlined" Clearable="true" /></MudItem>
                                        <MudItem xs="12" sm="4"><MudDatePicker Label="Fecha en que se percató" @bind-Date="input.FechaDeteccion" MaxDate="@DateTime.Today" DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Clearable="true" /></MudItem>
                                    </MudGrid>
                                </OptionalReportFields>
                                <MudTextField T="string" Label="Descripción de los hechos" @bind-Value="input.DescripcionHechos"
                                              Immediate="true" Required="true" Lines="5" MaxLength="4000" Variant="Variant.Outlined" />
                            </MudStack>
                        </MudStep>

                        <MudStep Title="Ubicación">
                            <MudStack Spacing="3" Class="py-4">
                                <OptionalReportFields Label="dirección o referencias" @bind-Added="hasAddress" OnRemove="ClearAddress">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudTextField T="string" Label="Código postal" Value="input.CodigoPostal"
                                                      ValueChanged="PostalCodeChanged" Immediate="true" MaxLength="5"
                                                      InputMode="InputMode.numeric" Variant="Variant.Outlined" />
                                        <MudButton OnClick="FindPostalAsync" Variant="Variant.Outlined" Disabled="searchingPostal">Buscar en SEPOMEX</MudButton>
                                    </MudStack>
                                    @if (postalMatches.Count > 0)
                                    {
                                        <MudSelect T="string" Label="Asentamiento en SEPOMEX" ValueChanged="SelectPostal" Variant="Variant.Outlined">
                                            @foreach (var item in postalMatches)
                                            {
                                                <MudSelectItem T="string" Value="@item.Clave">@item.Asentamiento · @item.Municipio, @item.Estado</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    @if (postalNotice is not null)
                                    {
                                        <MudText Typo="Typo.body2">@postalNotice</MudText>
                                    }
                                    <MudGrid>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Estado" @bind-Value="input.Estado" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Municipio" @bind-Value="input.Municipio" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Colonia o asentamiento" @bind-Value="input.Asentamiento" MaxLength="160" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Calle" @bind-Value="input.Calle" MaxLength="200" Variant="Variant.Outlined" /></MudItem>
                                    </MudGrid>
                                    <MudTextField T="string" Label="Referencias del lugar" @bind-Value="input.Referencias"
                                                  Lines="3" MaxLength="1000" Variant="Variant.Outlined" />
                                </OptionalReportFields>
                                <OptionalReportFields Label="punto en el mapa" @bind-Added="hasMapPoint" OnRemove="ClearCoordinates">
                                    <MudText Typo="Typo.body2">Haz clic en el lugar de los hechos o escribe las coordenadas.</MudText>
                                    <ReportLocationMap Label="Selecciona el lugar de los hechos"
                                                       Points="locationPins" OnSelect="SelectCoordinates" />
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double?" Label="Latitud" Value="input.Latitud" ValueChanged="SetLatitude"
                                                             Min="@(-90d)" Max="@(90d)" Step=".000001" HideSpinButtons="true" Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double?" Label="Longitud" Value="input.Longitud" ValueChanged="SetLongitude"
                                                             Min="@(-180d)" Max="@(180d)" Step=".000001" HideSpinButtons="true" Variant="Variant.Outlined" />
                                        </MudItem>
                                    </MudGrid>
                                </OptionalReportFields>
                            </MudStack>
                        </MudStep>

                        <MudStep Title="Datos adicionales">
                            <MudStack Spacing="3" Class="py-4">
                                <MudPaper Outlined="true" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle1" HtmlTag="h2">Quién reporta</MudText>
                                        <MudText Typo="Typo.body2">Estos datos se toman de tu perfil.</MudText>
                                        <MudText><strong>Nombre completo:</strong> @JoinKnown(" ", account.NombreCompleto)</MudText>
                                        <MudText><strong>Correo:</strong> @JoinKnown(" ", account.Correo)</MudText>
                                        <MudText><strong>Teléfono:</strong> @JoinKnown(" ", account.Telefono)</MudText>
                                    </MudStack>
                                </MudPaper>
                                <OptionalReportFields Label="tu vínculo con la persona reportada" @bind-Added="hasReporterRelationship" OnRemove="@(() => input.ParentescoReportanteId = null)" Disabled="@(catalog.Parentescos.Count == 0)">
                                    <ReportCatalogSelect Label="Tu vínculo con la persona reportada (opcional)"
                                                         Options="catalog.Parentescos" @bind-Value="input.ParentescoReportanteId" />
                                </OptionalReportFields>
                                <OptionalReportFields Label="vehículo relacionado" @bind-Added="hasVehicle" OnRemove="ClearVehicle">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Marca" @bind-Value="input.MarcaVehiculo" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Modelo" @bind-Value="input.ModeloVehiculo" MaxLength="120" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="Año" @bind-Value="input.AnoVehiculo"
                                                                                   HideSpinButtons="true" Format="0" Variant="Variant.Outlined" /></MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="ReportCatalogOption" Label="Color del vehículo" Value="vehicleColor" ValueChanged="SelectVehicleColor"
                                                             SearchFunc="SearchVehicleColors" ToStringFunc="@(color => color?.Nombre)"
                                                             Variant="Variant.Outlined" Clearable="true" ResetValueOnEmptyText="true"
                                                             Strict="false" Disabled="@(catalog.Colores.Count == 0)">
                                                <ItemTemplate Context="color">
                                                    @if (ReportDetails.ValidHex(color.ColorHex) is { } hex)
                                                    {
                                                        <span class="vehicle-color-swatch" style="@($"background-color: {hex}")" aria-hidden="true"></span>
                                                    }
                                                    @color.Nombre
                                                </ItemTemplate>
                                                <NoItemsTemplate>
                                                    <MudText Class="px-4 py-2">No hay colores con ese nombre.</MudText>
                                                </NoItemsTemplate>
                                            </MudAutocomplete>
                                        </MudItem>
                                        <MudItem xs="12" sm="6"><MudTextField T="string" Label="Número de placa" @bind-Value="input.PlacaVehiculo" MaxLength="30" Variant="Variant.Outlined" /></MudItem>
                                    </MudGrid>
                                </OptionalReportFields>
                                <OptionalReportFields Label="persona involucrada" @bind-Added="hasInvolvedPerson" OnRemove="ClearInvolvedPerson">
                                    <MudTextField T="string" Label="Nombre" @bind-Value="input.NombrePersonaRelacionada" MaxLength="160" Variant="Variant.Outlined" />
                                    <ReportCatalogSelect Label="Vínculo de la persona involucrada con la persona reportada (opcional)"
                                                         Options="catalog.Parentescos" @bind-Value="input.ParentescoPersonaRelacionadaId" />
                                    <MudTextField T="string" Label="Descripción de la persona o su participación" @bind-Value="input.DescripcionPersonaRelacionada"
                                                  Lines="3" MaxLength="1000" Variant="Variant.Outlined" />
                                </OptionalReportFields>
                            </MudStack>
                        </MudStep>

                        <MudStep Title="Revisión">
                            <MudStack Spacing="3" Class="py-4">
                                <MudText><strong>Persona reportada:</strong> @ReviewName</MudText>
                                <MudText><strong>Quién reporta:</strong> @JoinKnown(" · ", account.NombreCompleto, account.Correo, account.Telefono)</MudText>
                                @if (input.EstaturaCm is { } height)
                                {
                                    <MudText><strong>Estatura</strong> @height cm</MudText>
                                }
                                @if (catalog.Complexiones.FirstOrDefault(option => option.Id == input.ComplexionId) is { } complexion)
                                {
                                    <MudText><strong>Complexión</strong> @complexion.Nombre</MudText>
                                }
                                @if (reviewPhysicalTraits is { } traits)
                                {
                                    <MudText Style="white-space: pre-wrap"><strong>Rasgos físicos y vestimenta</strong><br />@traits</MudText>
                                }
                                <MudText><strong>Hechos:</strong> @input.DescripcionHechos</MudText>
                                <MudText><strong>Ubicación:</strong> @ReviewLocation</MudText>
                                @if (input.Latitud is { } lat && input.Longitud is { } lng)
                                {
                                    <MudText><strong>Coordenadas:</strong> @lat.ToString("F6"), @lng.ToString("F6")</MudText>
                                }
                                @if (catalog.Parentescos.FirstOrDefault(option => option.Id == input.ParentescoReportanteId) is { } reporterRelationship)
                                {
                                    <MudText><strong>Vínculo de quien reporta</strong> @reporterRelationship.Nombre</MudText>
                                }
                                @if (catalog.Parentescos.FirstOrDefault(option => option.Id == input.ParentescoPersonaRelacionadaId) is { } involvedRelationship)
                                {
                                    <MudText><strong>Vínculo de la persona involucrada</strong> @involvedRelationship.Nombre</MudText>
                                }
                                @if (reviewVehicle is { } vehicle)
                                {
                                    <MudText><strong>Vehículo</strong> @vehicle</MudText>
                                }
                                <MudCheckBox T="bool" @bind-Value="input.AutorizaPublicacion" Label="Autorizo la publicación de la ficha tras la revisión" />
                                <MudCheckBox T="bool" @bind-Value="input.MantenerAnonimato" Label="Mantener anónima mi identidad al público" />
                            </MudStack>
                        </MudStep>
                    </ChildContent>
                    <ActionContent Context="stepper">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Disabled="@(activeStep == 0 || saving)" OnClick="() => stepper.PreviousStepAsync()">Atrás</MudButton>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(saving || searchingPostal)"
                                       OnClick="() => stepper.NextStepAsync()">@(activeStep == ReviewStep ? "Guardar reporte" : "Continuar")</MudButton>
                        </MudStack>
                    </ActionContent>
                </MudStepper>
            </MudPaper>
        }
        else
        {
            <MudButton OnClick="LoadCatalogsAsync" Variant="Variant.Outlined">Volver a cargar el formulario</MudButton>
        }
    </MudStack>
</MudContainer>

@page "/reportes/crear"
@namespace NLDMAP.Server.Components.Pages.Reports
@using NLDMAP.Server.Components.Layout
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@layout ReportLayout

<PageTitle>Crear reporte | NLDMAP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <MudStack Spacing="4">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline">NLDMAP / Registro de reporte</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1">Crear reporte</MudText>
            <MudText Typo="Typo.body1">
                Comparte la información conocida sobre la persona y los hechos relacionados con su desaparición.
            </MudText>
        </MudStack>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Secciones del reporte</MudText>
                    <MudStepper @ref="_stepper"
                                @bind-ActiveIndex="_activeStep"
                                Vertical="true"
                                NonLinear="false"
                                ShowResetButton="false">
                        <ChildContent>
                            <MudStep Title="Persona" />
                            <MudStep Title="Características" />
                            <MudStep Title="Hechos" />
                            <MudStep Title="Ubicación" />
                            <MudStep Title="Información adicional" />
                            <MudStep Title="Privacidad y revisión" />
                        </ChildContent>
                        <ActionContent Context="navigation">
                        </ActionContent>
                    </MudStepper>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="9">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2" aria-live="polite">
                        Paso @(_activeStep + 1) de 6
                    </MudText>

                    @switch (_activeStep)
                    {
                        case 0:
                            @* PERSONA REPORTADA *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            01 · Identificación
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Persona reportada
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Escribe los datos que conozcas. Si desconoces el nombre, proporciona una descripción identificativa. No inventes datos para completar la captura.
                                        </MudText>
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.FirstNames"
                                                          Label="Nombre(s)"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.PaternalSurname"
                                                          Label="Primer apellido"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.MaternalSurname"
                                                          Label="Segundo apellido"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="_form.IdentifyingDescription"
                                              Label="Descripción identificativa"
                                              HelperText="Si desconoces el nombre, describe cómo se identifica o reconoce a la persona."
                                              Variant="Variant.Outlined"
                                              Lines="3" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Value="@_form.AgeInformationMode"
                                           ValueChanged="ChangeAgeInformationMode"
                                           Label="¿Qué información conoces sobre su edad?"
                                           Variant="Variant.Outlined"
                                           HelperText="Al cambiar de opción se borra el dato de edad o fecha que deja de utilizarse.">
                                    <MudSelectItem T="string" Value="@("birth-date")">Conozco la fecha de nacimiento</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("approximate-age")">Conozco una edad aproximada</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("unknown")">Desconozco esta información</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            @if (_form.AgeInformationMode == "birth-date")
                            {
                                <MudItem xs="12" md="6">
                                    <MudDatePicker @bind-Date="_form.BirthDate"
                                                   Label="Fecha de nacimiento"
                                                   Variant="Variant.Outlined"
                                                   DateFormat="dd/MM/yyyy"
                                                   Editable="true" />
                                </MudItem>
                            }
                            else if (_form.AgeInformationMode == "approximate-age")
                            {
                                <MudItem xs="12" md="6">
                                    <MudNumericField T="int?"
                                                     @bind-Value="_form.ApproximateAgeYears"
                                                     Label="Edad aproximada"
                                                     Variant="Variant.Outlined"
                                                     Min="0"
                                                     Adornment="Adornment.End"
                                                     AdornmentText="años"
                                                     HideSpinButtons="true"
                                                     HelperText="Años cumplidos aproximados. Para menores de un año, indica 0." />
                                </MudItem>
                            }

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.Curp"
                                                          Label="CURP"
                                                          MaxLength="18"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.Nicknames"
                                                          Label="Apodos"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.GenderId"
                                                          Label="Sexo y orientación sexual"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in GenderOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.NationalityId"
                                                       Label="Nacionalidad"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in NationalityOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.OccupationId"
                                                          Label="Ocupación"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in OccupationOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider />

                                    <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Outlined.Person"
                                                     Size="Size.Large"
                                                     Color="Color.Primary" />

                                            <MudText Typo="Typo.subtitle1">
                                                Fotografía de la persona
                                            </MudText>

                                            <MudText Typo="Typo.body2">
                                                JPG, JPEG o PNG · Hasta 5 MB
                                            </MudText>

                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Outlined.AddPhotoAlternate"
                                                       Disabled="true">
                                                Seleccionar fotografía
                                            </MudButton>

                                            <MudText Typo="Typo.caption">
                                                Carga de imagen pendiente en este mock.
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudStack>
                            </MudPaper>
                            break;

                        case 1:
                            @* CARACTERÍSTICAS *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            02 · Características
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Características y señas
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Rasgos que pueden ayudar a identificar a la persona.
                                        </MudText>
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="4">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.ComplexionId"
                                                          Label="Tez"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in ComplexionOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudNumericField T="decimal?"
                                                             @bind-Value="_form.HeightCm"
                                                             Label="Estatura"
                                                             Variant="Variant.Outlined"
                                                             Adornment="Adornment.End"
                                                             AdornmentText="cm"
                                                             HideSpinButtons="true" />
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudNumericField T="decimal?"
                                                             @bind-Value="_form.WeightKg"
                                                          Label="Peso"
                                                             Variant="Variant.Outlined"
                                                             Adornment="Adornment.End"
                                                             AdornmentText="kg"
                                                             HideSpinButtons="true" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.HairDescription"
                                                          Label="Descripción del cabello"
                                                          Placeholder="Color, longitud y características"
                                                          Variant="Variant.Outlined"
                                                          Lines="2" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.ClothingDescription"
                                                          Label="Descripción de la vestimenta"
                                                          Variant="Variant.Outlined"
                                                          Lines="3" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.FootwearDescription"
                                                          Label="Descripción del calzado"
                                                          Variant="Variant.Outlined"
                                                          Lines="3" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider />

                                    <MudText Typo="Typo.h6" HtmlTag="h3">
                                        Señas particulares
                                    </MudText>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.BodyRegionId"
                                                          Label="Región corporal"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in BodyRegionOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.MarkTypeId"
                                                          Label="Tipo de seña"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in MarkTypeOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.MarkDescription"
                                                          Label="Descripción de la seña"
                                                          Placeholder="Forma, tamaño, color o ubicación específica"
                                                          Variant="Variant.Outlined"
                                                          Lines="2" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Outlined.Add"
                                                       Disabled="true">
                                                Añadir otra seña
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>
                            break;

                        case 2:
                            @* HECHOS *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            03 · Hechos
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Hechos de la desaparición
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Describe lo ocurrido y las fechas conocidas.
                                        </MudText>
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.CircumstanceId"
                                                          Label="Circunstancia"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in CircumstanceOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudDatePicker @bind-Date="_form.EventDate"
                                                          Label="Fecha de los hechos"
                                                           Variant="Variant.Outlined"
                                                           DateFormat="dd/MM/yyyy"
                                                           Editable="true" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTimePicker @bind-Time="_form.EventTime"
                                                           Label="Hora de los hechos"
                                                           Variant="Variant.Outlined"
                                                           AmPm="false" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudDatePicker @bind-Date="_form.AwarenessDate"
                                                          Label="Fecha en que se percató"
                                                           Variant="Variant.Outlined"
                                                           DateFormat="dd/MM/yyyy"
                                                           Editable="true" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.FactsDescription"
                                                          Label="Descripción de los hechos"
                                                          Placeholder="Qué ocurrió, dónde fue vista y otra información conocida"
                                                          Variant="Variant.Outlined"
                                                          Lines="5" />
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>
                            break;

                        case 3:
                            @* UBICACIÓN *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            04 · Ubicación
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Ubicación de los hechos
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Indica el lugar relacionado con la desaparición.
                                        </MudText>
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="4">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.PostalCode"
                                                          Label="Código postal"
                                                          MaxLength="5"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.StateId"
                                                          Label="Estado"
                                                       Variant="Variant.Outlined">
                                                <MudSelectItem T="string" Value="@("tlaxcala")">
                                                    Tlaxcala
                                                </MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="4">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.MunicipalityId"
                                                          Label="Municipio"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                @foreach (var option in MunicipalityOptions)
                                                {
                                                    <MudSelectItem T="string" Value="@option.Id">
                                                        @option.Label
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_form.SettlementId"
                                                          Label="Colonia o asentamiento"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">
                                                <MudSelectItem T="string" Value="@("colonia-demo-1")">
                                                    Centro · Ejemplo
                                                </MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.Street"
                                                          Label="Calle"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField T="string"
                                                          @bind-Value="_form.LocationReferences"
                                                          Label="Referencias del lugar"
                                                          Variant="Variant.Outlined"
                                                          Lines="2" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudPaper Outlined="true" Elevation="0" Class="pa-8">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                                     Color="Color.Primary"
                                                     Size="Size.Large" />

                                            <MudText Typo="Typo.subtitle1">
                                                Ubicación en el mapa
                                            </MudText>

                                            <MudText Typo="Typo.body2" Align="Align.Center">
                                                Área reservada para seleccionar el punto.
                                            </MudText>

                                            <MudText Typo="Typo.caption">
                                                Mapa no conectado en este mock.
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudStack>
                            </MudPaper>
                            break;

                        case 4:
                            @* INFORMACIÓN ADICIONAL *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            05 · Información adicional
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Vehículo y persona involucrada
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Completa estos datos únicamente si conoces información.
                                        </MudText>
                                    </MudStack>

                                    <MudText Typo="Typo.h6" HtmlTag="h3">
                                        Vehículo involucrado
                                    </MudText>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" @bind-Value="_form.VehicleBrand"
                                                          Label="Marca"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" @bind-Value="_form.VehicleModel"
                                                          Label="Modelo"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" @bind-Value="_form.VehicleColor"
                                                          Label="Color"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" @bind-Value="_form.VehiclePlate"
                                                          Label="Número de placa"
                                                          Variant="Variant.Outlined" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider />

                                    <MudText Typo="Typo.h6" HtmlTag="h3">
                                        Persona involucrada
                                    </MudText>

                                    <MudTextField T="string"
                                                  @bind-Value="_form.InvolvedPersonName"
                                                          Label="Nombre"
                                                  Variant="Variant.Outlined" />

                                    <MudTextField T="string"
                                                  @bind-Value="_form.InvolvedPersonDescription"
                                                          Label="Descripción"
                                                  Variant="Variant.Outlined"
                                                  Lines="3" />
                                </MudStack>
                            </MudPaper>
                            break;

                        case 5:
                            @* PRIVACIDAD Y PUBLICACIÓN *@
                            <MudPaper Outlined="true" Elevation="0" Class="pa-6">
                                <MudStack Spacing="4">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.overline" Color="Color.Primary">
                                            06 · Publicación
                                        </MudText>

                                        <MudText Typo="Typo.h5" HtmlTag="h2">
                                            Privacidad y publicación
                                        </MudText>

                                        <MudText Typo="Typo.body2">
                                            Indica tu decisión sobre la publicación de la ficha
                                            y la visibilidad de tu identidad.
                                        </MudText>
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="bool?"
                                                       @bind-Value="_form.AuthorizePublication"
                                                       Label="Autorización para publicar la ficha"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">

                                                <MudSelectItem T="bool?" Value="@((bool?)true)">
                                                    Sí autorizo
                                                </MudSelectItem>

                                                <MudSelectItem T="bool?" Value="@((bool?)false)">
                                                    No autorizo
                                                </MudSelectItem>

                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSelect T="bool?"
                                                       @bind-Value="_form.KeepIdentityPrivate"
                                                       Label="Mantener anónima mi identidad al público"
                                                       Variant="Variant.Outlined"
                                                       Clearable="true">

                                                <MudSelectItem T="bool?" Value="@((bool?)true)">
                                                    Sí
                                                </MudSelectItem>

                                                <MudSelectItem T="bool?" Value="@((bool?)false)">
                                                    No
                                                </MudSelectItem>

                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>

                                    <MudAlert Severity="Severity.Info"
                                              Variant="Variant.Text"
                                              Dense="true">
                                        No autorizar la publicación no impide presentar el reporte.
                                        La información de contacto no se muestra en la ficha pública.
                                    </MudAlert>
                                </MudStack>
                            </MudPaper>
                            break;

                    }

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Button"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   Disabled="@(_activeStep <= 0)"
                                   OnClick="GoToPreviousStepAsync">
                            Anterior
                        </MudButton>
                        <MudSpacer />
                        @if (_activeStep < 5)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="GoToNextStepAsync">
                                Continuar
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       EndIcon="@Icons.Material.Filled.Send"
                                       Disabled="true">
                                Enviar reporte
                            </MudButton>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption">
                        Prototipo de captura. No se guarda ni se envía información.
                    </MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

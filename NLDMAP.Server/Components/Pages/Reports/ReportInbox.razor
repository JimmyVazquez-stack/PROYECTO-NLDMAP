@page "/gestion/reportes"
@rendermode InteractiveServer
@layout OperationsLayout
@attribute [Authorize(Policy = PermissionNames.Access)]
@using NLDMAP.Server.Components.Reports
@using NLDMAP.Server.Components.Reports.Models

<PageTitle>Bandeja de reportes | NLDMAP</PageTitle>
<MudThemeProvider Theme="theme" />
<MudPopoverProvider />

<div class="report-inbox">
    <h1>Bandeja de reportes</h1>
    <p class="scope">Vista de demostración · Tlaxcala</p>

    <MudPaper Elevation="0" Class="search-panel">
        <form class="search-form" @onsubmit="Search" @onsubmit:preventDefault>
            <MudTextField T="string" @bind-Value="searchText" Immediate="true" Label="Buscar por folio o nombre"
                          Variant="Variant.Text" MaxLength="100" Class="search-input" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Buscar</MudButton>
            <label class="sort-label">Fecha
                <select @bind="ascending" @bind:after="ResetPage">
                    <option value="false">Recientes primero</option>
                    <option value="true">Antiguos primero</option>
                </select>
            </label>
        </form>
    </MudPaper>

    <div class="inbox-tabs" role="group" aria-label="Filtrar por bandeja">
        @foreach (var stage in Enum.GetValues<InboxStage>())
        {
            <MudButton Variant="@(activeStage == stage ? Variant.Filled : Variant.Text)" Color="Color.Primary"
                       Class="stage-button" DropShadow="false" aria-pressed="@(activeStage == stage ? "true" : "false")"
                       OnClick="@(() => SelectStage(stage))">@StageName(stage) · @Count(stage)</MudButton>
        }
    </div>

    <MudTable T="ReportInboxRow" Items="VisibleRows" Elevation="0" Hover="true" Striped="true"
              Breakpoint="Breakpoint.Sm" Class="inbox-table">
        <HeaderContent>
            <MudTh>Folio</MudTh><MudTh>Persona reportada</MudTh><MudTh>Enviado</MudTh>
            <MudTh>Revisión</MudTh><MudTh>Publicación</MudTh><MudTh>Acción</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Folio">@context.Folio</MudTd>
            <MudTd DataLabel="Persona reportada">@context.PersonName</MudTd>
            <MudTd DataLabel="Enviado">@context.RegisteredOn.ToString("dd MMM yyyy", spanish)</MudTd>
            <MudTd DataLabel="Revisión">@context.ReviewStatus</MudTd>
            <MudTd DataLabel="Publicación">@context.PublicationStatus</MudTd>
            <MudTd DataLabel="Acción"><MudButton Color="Color.Primary" OnClick="@(() => selected = context)"
                aria-label="@($"Ver reporte {context.Folio}")">Ver reporte</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><p class="empty-state">No hay reportes en esta bandeja con la búsqueda indicada.</p></NoRecordsContent>
    </MudTable>

    <div class="pagination">
        <p role="status">@Total reportes · Página @(page) de @TotalPages</p>
        <div class="pagination-controls">
            <label>Por página <select @bind="pageSize" @bind:after="ResetPage"><option value="1">1</option><option value="10">10</option><option value="20">20</option></select></label>
            <MudButton Disabled="@(page <= 1)" OnClick="PreviousPage" aria-label="Página anterior">Anterior</MudButton>
            <MudButton Disabled="@(page >= TotalPages)" OnClick="NextPage" aria-label="Página siguiente">Siguiente</MudButton>
        </div>
    </div>

    @if (selected is not null)
    {
        <ReportPreview Report="selected" OnClose="ClosePreview" />
    }

    <aside class="attention" aria-labelledby="attention-title">
        <h2 id="attention-title">Atención pendiente</h2>
        <p>Abrir un reporte permite consultar sus datos, sin iniciar ni aprobar su revisión.</p>
    </aside>
    <div class="refresh-line">
        <span>Última consulta de ejemplos: @refreshedAt.ToString("dd MMM yyyy, HH:mm", spanish) UTC</span>
        <MudButton Color="Color.Primary" OnClick="Refresh">Actualizar consulta</MudButton>
    </div>
    <p class="demo-note">Datos ficticios para validación del diseño · SAL-P-03 · Sin conexión a reportes reales.</p>
</div>

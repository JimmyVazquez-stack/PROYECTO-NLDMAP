@page "/admin/roles"
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.RolesRead)]
@inherits AdminPageBase

<PageTitle>Roles y permisos | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4" HtmlTag="h1">Roles y permisos</MudText>
        @if (CanManage)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Disabled="Busy" OnClick="NewRole">
                Nuevo rol
            </MudButton>
        }
    </MudStack>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (!string.IsNullOrEmpty(Notice))
    {
        <MudAlert Severity="Severity.Success" role="status">@Notice</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Procesando roles" />
    }

    @if (editing is not null && CanManage)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <EditForm Model="editing" OnValidSubmit="SaveAsync" FormName="role-editor" @key="editing">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">
                    <MudText Typo="Typo.h6" HtmlTag="h2">
                        @(editing.Id is null ? "Crear rol" : "Editar rol")
                    </MudText>

                    <MudTextField T="string" Label="Nombre" Variant="Variant.Outlined"
                                  @bind-Value="editing.Name" For="() => editing.Name"
                                  MaxLength="80" Immediate="true"
                                  ReadOnly="protectedName" Disabled="Busy" />

                    <MudText Typo="Typo.body2">
                        Los usuarios reciben la suma de permisos de sus roles.
                        Guardar cambios revoca las sesiones de sus integrantes.
                    </MudText>

                    <MudGrid Spacing="2">
                        @foreach (var permission in PermissionNames.Catalog)
                        {
                            <MudItem xs="12" md="6" @key="permission.Key">
                                <MudCheckBox T="bool" Label="@($"{permission.Value} ({permission.Key})")"
                                             Color="Color.Primary" Value="@selected.Contains(permission.Key)"
                                             ValueChanged="@(value => Toggle(permission.Key, value))"
                                             Disabled="@(Busy || Access?.Allows(permission.Key) != true)" />
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                   Color="Color.Primary" Disabled="Busy">
                            Guardar rol
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="Busy"
                                   OnClick="() => editing = null">
                            Cancelar
                        </MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>
        </MudPaper>
    }

    @if (deleting is not null && CanManage)
    {
        <MudAlert Severity="Severity.Warning">
            <MudStack Spacing="2">
                <MudText>¿Eliminar el rol <strong>@deleting.Name</strong>?</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               Disabled="Busy" OnClick="DeleteAsync">
                        Confirmar eliminación
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="Busy"
                               OnClick="() => deleting = null">
                        Cancelar
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudAlert>
    }

    <MudTable T="RoleRow" Items="roles" Hover="true"
              Breakpoint="Breakpoint.Sm" Elevation="1" Context="role">
        <HeaderContent>
            <MudTh>Rol</MudTh>
            <MudTh>Usuarios</MudTh>
            <MudTh>Permisos</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Rol">
                <MudText Typo="Typo.subtitle2">@role.Name</MudText>
                @if (role.IsProtected)
                {
                    <MudText Typo="Typo.caption">Rol del sistema</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Usuarios">@role.Users</MudTd>
            <MudTd DataLabel="Permisos">
                @if (role.Permissions.Length == 0)
                {
                    <MudText Typo="Typo.body2">Sin permisos</MudText>
                }
                else
                {
                    <details>
                        <summary>@role.Permissions.Length permisos</summary>
                        <ul>
                            @foreach (var permission in role.Permissions)
                            {
                                <li>@(permission == PermissionNames.ReportsCreate
                                    ? "Crear reportes"
                                    : PermissionNames.Catalog.GetValueOrDefault(permission, permission))</li>
                            }
                        </ul>
                    </details>
                }
            </MudTd>
            <MudTd DataLabel="Acciones">
                @if (CanManage && role.Name != RoleNames.Administrator && !RoleNames.IsCitizenRole(role.Name))
                {
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   Disabled="Busy" OnClick="() => Edit(role)">
                            Editar
                        </MudButton>
                        @if (!role.IsProtected && role.Users == 0)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       Disabled="Busy" OnClick="() => deleting = role">
                                Eliminar
                            </MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.caption">
                        @(role.IsProtected ? "Protegido" : "Solo lectura")
                    </MudText>
                }
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Class="pa-4">@(Busy ? "Cargando roles…" : "No hay roles para mostrar.")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudStack>

@code {
    private IReadOnlyList<RoleRow> roles = [];
    private RoleInput? editing;
    private RoleRow? deleting;
    private HashSet<string> selected = [];
    private bool protectedName;

    private bool CanManage => Access?.Allows(PermissionNames.RolesManage) == true;

    protected override async Task LoadAsync() => roles = await Admin.GetRolesAsync();

    private void NewRole()
    {
        editing = new();
        selected = [];
        protectedName = false;
    }

    private void Edit(RoleRow role)
    {
        editing = new()
        {
            Id = role.Id,
            Name = role.Name,
            ConcurrencyStamp = role.ConcurrencyStamp
        };
        selected = role.Permissions.ToHashSet();
        protectedName = role.IsProtected;
    }

    private void Toggle(string permission, bool value)
    {
        if (value)
            selected.Add(permission);
        else
            selected.Remove(permission);
    }

    private Task SaveAsync()
    {
        if (!CanManage || editing is not { } input)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            input.Permissions = selected.ToArray();
            await Admin.SaveRoleAsync(input);
            editing = null;
            await LoadAsync();
        }, "Rol guardado.");
    }

    private Task DeleteAsync()
    {
        if (!CanManage || deleting is not { } role)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await Admin.DeleteRoleAsync(role.Id, role.ConcurrencyStamp);
            deleting = null;
            await LoadAsync();
        }, "Rol eliminado.");
    }
}

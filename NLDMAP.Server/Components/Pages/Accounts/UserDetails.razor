@page "/admin/usuarios/{UserId}"
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.UsersRead)]
@inherits AdminPageBase

<PageTitle>Detalle de cuenta | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudButton Href="/admin/usuarios" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Usuarios
        </MudButton>
    </div>

    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Detalle de cuenta</MudText>
        @if (user is not null && loadedId == UserId)
        {
            <MudText Typo="Typo.body2">@user.Email</MudText>
        }
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (!string.IsNullOrEmpty(Notice))
    {
        <MudAlert Severity="Severity.Success" role="status">@Notice</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Procesando detalle de cuenta" />
    }

    @if (user is not null && loadedId == UserId && Access is not null)
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="7">
                <MudStack Spacing="3">
                    <MudPaper Class="pa-4" Elevation="1">
                        <EditForm Model="profile" OnValidSubmit="SaveProfileAsync" FormName="edit-user">
                            <DataAnnotationsValidator />
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6" HtmlTag="h2">Perfil</MudText>

                                <MudTextField T="string" Label="Nombre" Variant="Variant.Outlined"
                                              @bind-Value="profile.DisplayName" For="() => profile.DisplayName"
                                              MaxLength="120" Immediate="true"
                                              ReadOnly="@(!CanEditProfile)" Disabled="Busy" />

                                <MudTextField T="string" Label="Teléfono" Variant="Variant.Outlined"
                                              @bind-Value="profile.PhoneNumber" For="() => profile.PhoneNumber"
                                              InputType="InputType.Telephone" MaxLength="30" Immediate="true"
                                              ReadOnly="@(!CanEditProfile)" Disabled="Busy" />

                                @if (CanEditProfile)
                                {
                                    <div>
                                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                                   Color="Color.Primary" Disabled="Busy">
                                            Guardar perfil
                                        </MudButton>
                                    </div>
                                }
                            </MudStack>
                        </EditForm>
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6" HtmlTag="h2">Estado de la cuenta</MudText>

                            <div>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@(user.IsActive ? Color.Success : Color.Default)">
                                    @(user.IsActive ? "Activa" : "Inactiva")
                                </MudChip>
                            </div>

                            @if (CanChangeStatus)
                            {
                                @if (confirmStatus)
                                {
                                    <MudAlert Severity="Severity.Warning" role="alert">
                                        @if (user.IsActive)
                                        {
                                            <text>¿Confirmas desactivar esta cuenta? La cuenta perderá el acceso.</text>
                                        }
                                        else
                                        {
                                            <text>¿Confirmas activar esta cuenta?</text>
                                        }
                                    </MudAlert>

                                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(user.IsActive ? Color.Error : Color.Primary)"
                                                   Disabled="Busy" OnClick="ChangeStatusAsync">
                                            Confirmar cambio
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Disabled="Busy"
                                                   OnClick="() => confirmStatus = false">
                                            Cancelar
                                        </MudButton>
                                    </MudStack>
                                }
                                else
                                {
                                    <div>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="@(user.IsActive ? Color.Error : Color.Primary)"
                                                   Disabled="Busy" OnClick="() => confirmStatus = true">
                                            @(user.IsActive ? "Desactivar cuenta" : "Activar cuenta")
                                        </MudButton>
                                    </div>
                                }
                            }
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>

            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6" HtmlTag="h2">Roles asignados</MudText>
                        @if (HasCitizenRole)
                        {
                            <MudText Typo="Typo.body2">El rol público cambia al completar el perfil.</MudText>
                        }
                        else if (CanAssignRoles)
                        {
                            <MudText Typo="Typo.body2">
                                Los cambios de roles requieren que esta cuenta vuelva a iniciar sesión.
                            </MudText>
                        }

                        @foreach (var role in roles.Where(role =>
                            HasCitizenRole ? user.RoleIds.Contains(role.Id) : !RoleNames.IsCitizenRole(role.Name)))
                        {
                            <MudCheckBox T="bool" Label="@role.Name" Color="Color.Primary"
                                         Value="@selected.Contains(role.Id)"
                                         ValueChanged="@(value => Toggle(role.Id, value))"
                                         Disabled="@(Busy || !CanAssignRoles || RoleNames.IsCitizenRole(role.Name))" @key="role.Id" />
                        }

                        @if (CanAssignRoles)
                        {
                            <div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="Busy" OnClick="SaveRolesAsync">
                                    Guardar roles
                                </MudButton>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private UserDetail? user;
    private UserProfileInput profile = new();
    private IReadOnlyList<RoleRow> roles = [];
    private HashSet<string> selected = [];
    private bool confirmStatus;
    private string? loadedId;

    private bool CanEditProfile => Access?.Allows(PermissionNames.UsersEdit) == true;
    private bool CanChangeStatus => Access?.Allows(PermissionNames.UsersStatus) == true;
    private bool HasCitizenRole => user is not null && roles.Any(role =>
        user.RoleIds.Contains(role.Id) && RoleNames.IsCitizenRole(role.Name));
    private bool CanAssignRoles => !HasCitizenRole && Access?.Allows(PermissionNames.RolesAssign) == true;

    protected override async Task LoadAsync()
    {
        var requestedId = UserId;
        var detail = await Admin.GetUserAsync(requestedId);
        var availableRoles = await Admin.GetRolesAsync();

        user = detail;
        roles = availableRoles;
        profile = new()
        {
            UserId = detail.Id,
            ConcurrencyStamp = detail.ConcurrencyStamp,
            DisplayName = detail.DisplayName,
            PhoneNumber = detail.PhoneNumber
        };
        selected = detail.RoleIds.ToHashSet();
        confirmStatus = false;
        loadedId = requestedId;
    }

    protected override Task OnParametersSetAsync() =>
        Access is not null && loadedId != UserId ? RunAsync(LoadAsync) : Task.CompletedTask;

    private void Toggle(string id, bool value)
    {
        if (value)
            selected.Add(id);
        else
            selected.Remove(id);
    }

    private Task SaveProfileAsync()
    {
        if (!CanEditProfile || loadedId != UserId)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await Admin.UpdateUserAsync(profile);
            await LoadAsync();
        }, "Perfil actualizado.");
    }

    private Task SaveRolesAsync()
    {
        if (!CanAssignRoles || user is not { } detail || loadedId != UserId)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            var staffRoleIds = roles
                .Where(role => selected.Contains(role.Id) && !RoleNames.IsCitizenRole(role.Name))
                .Select(role => role.Id).ToArray();
            await Admin.SetUserRolesAsync(new(detail.Id, detail.ConcurrencyStamp, staffRoleIds));
            await LoadAsync();
        }, "Roles actualizados. La cuenta deberá volver a iniciar sesión.");
    }

    private Task ChangeStatusAsync()
    {
        if (!CanChangeStatus || user is not { } detail || loadedId != UserId)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await Admin.SetUserStatusAsync(new(detail.Id, detail.ConcurrencyStamp, !detail.IsActive));
            await LoadAsync();
        }, "Estado actualizado.");
    }
}

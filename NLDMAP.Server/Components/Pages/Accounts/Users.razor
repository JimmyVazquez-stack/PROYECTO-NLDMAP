@page "/admin/usuarios"
@layout AdministrationLayout
@attribute [Authorize(Policy = PermissionNames.UsersRead)]
@inherits AdminPageBase

<PageTitle>Usuarios | NLDMAP</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Usuarios</MudText>
        <MudText Typo="Typo.body2">
            Busca cuentas y consulta sus permisos de acceso.
        </MudText>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@Error</MudAlert>
    }

    @if (Busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           aria-label="Consultando usuarios" />
    }

    <MudPaper Class="pa-4" Elevation="1">
        <EditForm Model="filters" OnValidSubmit="SearchAsync" FormName="user-filters">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="Nombre o correo" Variant="Variant.Outlined"
                                  @bind-Value="filters.Search" MaxLength="100"
                                  Immediate="true" Disabled="Busy" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="bool?" Label="Estado" Placeholder="Todos" Variant="Variant.Outlined"
                               @bind-Value="filters.IsActive" Disabled="Busy">
                        <MudSelectItem T="bool?" Value="@((bool?)null)">Todos</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Activos</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Inactivos</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Rol" Placeholder="Todos" Variant="Variant.Outlined"
                               @bind-Value="filters.RoleId" Disabled="Busy">
                        <MudSelectItem T="string" Value="@string.Empty">Todos</MudSelectItem>
                        @foreach (var role in roles)
                        {
                            <MudSelectItem T="string" Value="@role.Id">@role.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Primary" FullWidth="true" Disabled="Busy">
                        Consultar
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>

    @if (users is not null)
    {
        <MudTable T="UserRow" Items="users.Items" Hover="true"
                  Breakpoint="Breakpoint.Sm" Elevation="1" Context="user">
            <HeaderContent>
                <MudTh>Cuenta</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Cuenta">
                    <MudText Typo="Typo.subtitle2">
                        @(string.IsNullOrWhiteSpace(user.DisplayName) ? "Sin nombre" : user.DisplayName)
                    </MudText>
                    <MudText Typo="Typo.caption">@user.Email</MudText>
                </MudTd>
                <MudTd DataLabel="Roles">
                    @(user.Roles.Length == 0 ? "Sin roles" : string.Join(", ", user.Roles))
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(user.IsActive ? Color.Success : Color.Default)">
                        @(user.IsActive ? "Activa" : "Inactiva")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudButton Href="@($"/admin/usuarios/{Uri.EscapeDataString(user.Id)}")"
                               Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                        Ver cuenta
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">No hay cuentas con estos filtros.</MudText>
            </NoRecordsContent>
        </MudTable>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                  Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">@users.Total resultados</MudText>
            @if (users.TotalPages > 1)
            {
                <MudPagination Count="users.TotalPages" Selected="users.Page"
                               SelectedChanged="ChangePageAsync" Disabled="Busy"
                               Color="Color.Primary" />
            }
        </MudStack>
    }
</MudStack>

@code {
    private sealed class Filters
    {
        public string Search { get; set; } = "";
        public bool? IsActive { get; set; }
        public string RoleId { get; set; } = "";
    }

    private readonly Filters filters = new();
    private IReadOnlyList<RoleRow> roles = [];
    private PageResult<UserRow>? users;
    private UserQuery appliedQuery = new();

    protected override async Task LoadAsync()
    {
        roles = await Admin.GetRolesAsync();
        await LoadUsersAsync(appliedQuery);
    }

    private async Task LoadUsersAsync(UserQuery query)
    {
        users = await Admin.GetUsersAsync(query);
        appliedQuery = query;
    }

    private Task SearchAsync() =>
        RunAsync(() => LoadUsersAsync(new UserQuery(filters.Search, filters.IsActive, filters.RoleId)));

    private Task ChangePageAsync(int page) =>
        RunAsync(() => LoadUsersAsync(appliedQuery with { Page = page }));
}

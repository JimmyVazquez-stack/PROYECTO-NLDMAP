@page "/Account/AcceptInvitation"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [StreamRendering(false)]
@using NLDMAP.Application.Accounts
@inject IAccountLifecycle Accounts
@inject ILogger<AcceptInvitation> Logger
<PageTitle>Aceptar invitación | NLDMAP</PageTitle>
<h1 class="h3 mb-3">Aceptar invitación</h1>
@if (done)
{
    <div class="alert alert-success" role="status">Cuenta creada. Ya puedes iniciar sesión.</div>
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <p class="small text-body-secondary">Usa al menos 12 caracteres, mayúsculas, minúsculas, números y un símbolo.</p>
    <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="accept-invitation">
        <DataAnnotationsValidator />
        <input type="hidden" name="Input.Token" value="@Input.Token" />

        <div class="mb-3"><label class="form-label" for="new-password">Contraseña</label><InputText class="form-control" id="new-password" type="password" autocomplete="new-password" @bind-Value="Input.Password" /><ValidationMessage For="() => Input.Password" /></div>
        <div class="mb-3"><label class="form-label" for="confirm-password">Confirmar contraseña</label><InputText class="form-control" id="confirm-password" type="password" autocomplete="new-password" @bind-Value="Input.ConfirmPassword" /><ValidationMessage For="() => Input.ConfirmPassword" /></div>
        <button class="btn btn-primary w-100" type="submit">Guardar contraseña</button>
    </EditForm>
}
<a href="Account/Login" class="d-inline-block mt-3" data-enhance-nav="false">Ir al inicio de sesión</a>
@code {
    [SupplyParameterFromQuery(Name = "token")] public string? QueryToken { get; set; }

    [SupplyParameterFromForm(FormName = "accept-invitation")] private PasswordInput Input { get; set; } = default!;
    private string? error;
    private bool done;
    protected override void OnParametersSet() { Input ??= new(); Input.Token ??= QueryToken; }
    private async Task SubmitAsync()
    {
        try { await Accounts.AcceptInvitationAsync(Input.Token ?? "", Input.Password); done = true; }
        catch (AdministrationException ex) { error = ex.Message; }
        catch (Exception) { Logger.LogError("Error procesando un enlace de cuenta."); error = "No se pudo completar la operación. Solicita un enlace nuevo o inténtalo más tarde."; }
        finally { Input.Password = ""; Input.ConfirmPassword = ""; }
    }
    private sealed class PasswordInput
    {
        public string? Token { get; set; }
        public string? Email { get; set; }
        [Required(ErrorMessage = "Escribe una contraseña."), StringLength(256, MinimumLength = 12, ErrorMessage = "Usa entre 12 y 256 caracteres.")]
        public string Password { get; set; } = "";
        [Required(ErrorMessage = "Confirma la contraseña."), Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

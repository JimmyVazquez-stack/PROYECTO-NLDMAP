@page "/Account/ForgotPassword"
@page "/cuenta/recuperar"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [StreamRendering(false)]

@using Microsoft.AspNetCore.Http
@using NLDMAP.Application.Accounts
@using NLDMAP.Server.Theming
@inject NavigationManager Navigation
@inject IAccountLifecycle Accounts
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar contraseña | NLDMAP</PageTitle>

<MudThemeProvider Theme="@(IsCitizenPage ? publicTheme : theme)" IsDarkMode="@IsDarkMode" />

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
          Class="pa-4" Style="min-height: 100dvh; background: var(--mud-palette-background);">
    <MudContainer MaxWidth="MaxWidth.ExtraSmall">
        <MudPaper Elevation="3" Class="pa-6">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5" HtmlTag="h1">Recuperar contraseña</MudText>

                @if (sent)
                {
                    <MudAlert Severity="Severity.Info" role="status">
                        Si el correo corresponde a una cuenta activa, recibirás instrucciones para restablecer tu contraseña.
                    </MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        Escribe el correo de tu cuenta.
                    </MudText>

                    <EditForm Model="Input" method="post" OnValidSubmit="SendAsync"
                              FormName="forgot-password" Enhance="false">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="2">
                            <MudTextField T="string" Label="Correo electrónico" InputType="MudBlazor.InputType.Email"
                                          Variant="Variant.Outlined" @bind-Value="Input.Email"
                                          MaxLength="256" UserAttributes="EmailAttributes" />
                            <div role="status" style="color: var(--mud-palette-error);">
                                <ValidationMessage For="() => Input.Email" />
                            </div>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                       Color="Color.Primary" FullWidth="true">
                                Enviar instrucciones
                            </MudButton>
                        </MudStack>
                    </EditForm>
                }

                <MudLink Href="@LoginPath" data-enhance-nav="false">
                    Volver al inicio de sesión
                </MudLink>
            </MudStack>
        </MudPaper>
    </MudContainer>
</MudStack>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "forgot-password")]
    private RecoveryInput Input { get; set; } = default!;

    private readonly MudTheme theme = NldmapTheme.Create();
    private readonly MudTheme publicTheme = NldmapTheme.CreatePublic();
    private bool IsCitizenPage => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("cuenta/", StringComparison.OrdinalIgnoreCase);
    private string LoginPath => IsCitizenPage ? "/cuenta/entrar" : "/Account/Login";

    private bool IsDarkMode => !IsCitizenPage && HttpContext?.Request.Cookies["nldmap-theme"] != "light";
    private bool sent;

    private static readonly Dictionary<string, object> EmailAttributes = new()
    {
        ["name"] = "Input.Email",
        ["autocomplete"] = "username",
        ["aria-required"] = "true"
    };

    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        try
        {
            await Accounts.RequestPasswordResetAsync(Input.Email,
                IsCitizenPage ? AccountAudience.Citizen : AccountAudience.Staff);
        }
        catch (Exception)
        {
            Logger.LogError("Error procesando una solicitud de recuperación.");
        }

        sent = true;
    }

    private sealed class RecoveryInput
    {
        [Required(ErrorMessage = "Escribe tu correo.")]
        [EmailAddress(ErrorMessage = "Escribe un correo válido.")]
        [StringLength(256, ErrorMessage = "El correo es demasiado largo.")]
        public string Email { get; set; } = "";
    }
}

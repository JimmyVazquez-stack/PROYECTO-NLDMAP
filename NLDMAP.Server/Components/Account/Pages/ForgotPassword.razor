@page "/Account/ForgotPassword"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [StreamRendering(false)]
@using NLDMAP.Application.Accounts
@inject IAccountLifecycle Accounts
@inject ILogger<ForgotPassword> Logger
<PageTitle>Recuperar contraseña | NLDMAP</PageTitle>
<h1 class="h3 mb-3">Recuperar contraseña</h1>
@if (sent)
{
    <div class="alert alert-info" role="status">Si el correo corresponde a una cuenta activa, recibirás instrucciones para restablecer tu contraseña.</div>
}
else
{
    <p class="text-body-secondary">Escribe el correo de tu cuenta.</p>
    <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password">
        <DataAnnotationsValidator /><div class="mb-3"><label class="form-label" for="recovery-email">Correo electrónico</label><InputText class="form-control" id="recovery-email" type="email" autocomplete="username" @bind-Value="Input.Email" /><ValidationMessage For="() => Input.Email" /></div><button class="btn btn-primary w-100" type="submit">Enviar instrucciones</button>
    </EditForm>
}
<a href="Account/Login" class="d-inline-block mt-3" data-enhance-nav="false">Volver al inicio de sesión</a>
@code {
    [SupplyParameterFromForm(FormName = "forgot-password")] private RecoveryInput Input { get; set; } = default!;
    private bool sent;
    protected override void OnInitialized() => Input ??= new();

    private async Task SendAsync()
    {
        try { await Accounts.RequestPasswordResetAsync(Input.Email); }
        catch (Exception) { Logger.LogError("Error procesando una solicitud de recuperación."); }
        sent = true;
    }
    private sealed class RecoveryInput
    {
        [Required(ErrorMessage = "Escribe tu correo."), EmailAddress(ErrorMessage = "Escribe un correo válido."), StringLength(256)]
        public string Email { get; set; } = "";
    }
}

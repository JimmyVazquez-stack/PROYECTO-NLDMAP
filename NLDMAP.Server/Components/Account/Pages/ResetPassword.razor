@page "/Account/ResetPassword"
@page "/cuenta/restablecer"
@layout AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [StreamRendering(false)]

@using Microsoft.AspNetCore.Http
@using NLDMAP.Application.Accounts
@using NLDMAP.Server.Theming
@inject NavigationManager Navigation
@inject IAccountLifecycle Accounts
@inject ILogger<ResetPassword> Logger

<PageTitle>Nueva contraseña | NLDMAP</PageTitle>
<HeadContent>
    <meta name="referrer" content="no-referrer" />
</HeadContent>

<MudThemeProvider Theme="@(IsCitizenPage ? publicTheme : theme)" IsDarkMode="@IsDarkMode" />

<MudStack AlignItems="AlignItems.Center" Justify="Justify.Center"
          Class="pa-4" Style="min-height: 100dvh; background: var(--mud-palette-background);">
    <MudContainer MaxWidth="MaxWidth.ExtraSmall">
        <MudPaper Elevation="3" Class="pa-6">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h5" HtmlTag="h1">Nueva contraseña</MudText>

                @if (done)
                {
                    <MudAlert Severity="Severity.Success" role="status">
                        Contraseña actualizada. Inicia sesión con tu nueva contraseña.
                    </MudAlert>
                }
                else if (!HasRecoveryLink)
                {
                    <MudAlert Severity="Severity.Warning" role="alert">
                        El enlace de recuperación está incompleto. Solicita uno nuevo.
                    </MudAlert>
                    <MudLink Href="@RecoveryPath" data-enhance-nav="false">
                        Solicitar otro enlace
                    </MudLink>
                }
                else
                {
                    @if (error is not null)
                    {
                        <MudAlert Severity="Severity.Error" role="alert">@error</MudAlert>
                        <MudLink Href="@RecoveryPath" data-enhance-nav="false">
                            Solicitar otro enlace
                        </MudLink>
                    }

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                        Usa al menos 12 caracteres, mayúsculas, minúsculas, números y un símbolo.
                    </MudText>
                    <EditForm Model="Input" method="post" FormName="reset-password" Enhance="false"
                              OnValidSubmit="SubmitAsync" OnInvalidSubmit="ClearPasswords">
                        <DataAnnotationsValidator />
                        <input type="hidden" name="Input.Token" value="@Input.Token" />
                        <input type="hidden" name="Input.Email" value="@Input.Email" />

                        <MudStack Spacing="2">
                            <div>
                                <MudTextField T="string" Label="Contraseña" Variant="Variant.Outlined"
                                              InputType="MudBlazor.InputType.Password" MaxLength="256"
                                              @bind-Value="Input.Password" UserAttributes="PasswordAttributes" />
                                <div role="status" style="color: var(--mud-palette-error);">
                                    <ValidationMessage For="() => Input.Password" />
                                </div>
                            </div>
                            <div>
                                <MudTextField T="string" Label="Confirmar contraseña" Variant="Variant.Outlined"
                                              InputType="MudBlazor.InputType.Password" MaxLength="256"
                                              @bind-Value="Input.ConfirmPassword" UserAttributes="ConfirmPasswordAttributes" />
                                <div role="status" style="color: var(--mud-palette-error);">
                                    <ValidationMessage For="() => Input.ConfirmPassword" />
                                </div>
                            </div>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                       Color="Color.Primary" FullWidth="true">
                                Guardar contraseña
                            </MudButton>
                        </MudStack>
                    </EditForm>
                }

                <MudLink Href="@LoginPath" data-enhance-nav="false">
                    Ir al inicio de sesión
                </MudLink>
            </MudStack>
        </MudPaper>
    </MudContainer>
</MudStack>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? QueryToken { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? QueryEmail { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private PasswordInput Input { get; set; } = default!;

    private string? error;
    private bool done;
    private readonly MudTheme theme = NldmapTheme.Create();
    private readonly MudTheme publicTheme = NldmapTheme.CreatePublic();
    private bool IsCitizenPage => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("cuenta/", StringComparison.OrdinalIgnoreCase);
    private string LoginPath => IsCitizenPage ? "/cuenta/entrar" : "/Account/Login";

    private string RecoveryPath => IsCitizenPage ? "/cuenta/recuperar" : "/Account/ForgotPassword";

    private bool IsDarkMode => !IsCitizenPage && HttpContext?.Request.Cookies["nldmap-theme"] != "light";
    private bool HasRecoveryLink => !string.IsNullOrWhiteSpace(Input.Token) && !string.IsNullOrWhiteSpace(Input.Email);

    private static readonly Dictionary<string, object> PasswordAttributes = new()
    {
        ["name"] = "Input.Password",
        ["autocomplete"] = "new-password",
        ["aria-required"] = "true"
    };

    private static readonly Dictionary<string, object> ConfirmPasswordAttributes = new()
    {
        ["name"] = "Input.ConfirmPassword",
        ["autocomplete"] = "new-password",
        ["aria-required"] = "true"
    };

    protected override void OnParametersSet()
    {
        Input ??= new();
        Input.Token ??= QueryToken;
        Input.Email ??= QueryEmail;
    }

    private async Task SubmitAsync()
    {
        try
        {
            await Accounts.ResetPasswordAsync(Input.Email ?? "", Input.Token ?? "", Input.Password);
            done = true;
        }
        catch (AdministrationException exception)
        {
            error = exception.Message;
        }
        catch (Exception)
        {
            Logger.LogError("Error procesando un enlace de cuenta.");
            error = "No se pudo completar la operación. Solicita un enlace nuevo o inténtalo más tarde.";
        }
        finally
        {
            ClearPasswords();
        }
    }

    private void ClearPasswords()
    {
        Input.Password = "";
        Input.ConfirmPassword = "";
    }

    private sealed class PasswordInput
    {
        public string? Token { get; set; }
        public string? Email { get; set; }

        [Required(ErrorMessage = "Escribe una contraseña.")]
        [StringLength(256, MinimumLength = 12, ErrorMessage = "Usa entre 12 y 256 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirma la contraseña.")]
        [StringLength(256, ErrorMessage = "La confirmación es demasiado larga.")]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";
    }
}

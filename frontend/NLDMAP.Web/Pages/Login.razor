@page "/login"
@inject CookieAuthStateProvider AuthState
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject HttpClient Http
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<PageTitle>Acceso a NLDMAP</PageTitle>

<h1>Acceso a NLDMAP</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (busy)
{
    <p>Procesando...</p>
}

@if (session is null)
{
    <EditForm Model="form" OnValidSubmit="LoginAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset disabled="@busy" style="max-width: 420px;">
            <div class="mb-3">
                <label for="email" class="form-label">Correo</label>
                <InputText id="email"
                           type="email"
                           class="form-control"
                           autocomplete="username"
                           @bind-Value="form.Email" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">
                    Contraseña
                </label>
                <InputText id="password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           @bind-Value="form.Password" />
            </div>

            <button type="submit" class="btn btn-primary">
                Entrar
            </button>
        </fieldset>
    </EditForm>
}
else
{
    <div class="alert alert-success">
        <p>Sesión iniciada: <strong>@session.Email</strong></p>
        <p>Roles: @string.Join(", ", session.Roles)</p>
    </div>

    <button class="btn btn-outline-danger"
            disabled="@busy"
            @onclick="LogoutAsync">
        Cerrar sesión
    </button>
}

@code {
    private readonly LoginInput form = new();
    private SessionInfo? session;
    private string? error;
    private bool busy;

    protected override Task OnInitializedAsync()
        => ExecuteAsync(LoadSessionAsync);

    private Task LoginAsync() => ExecuteAsync(async () =>
    {
        using var response = await SendAsync(
            HttpMethod.Post, "api/auth/login", form);

        form.Password = string.Empty;

        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            error = "No fue posible iniciar sesión. Revisa tus credenciales.";
            return;
        }

        response.EnsureSuccessStatusCode();

        await LoadSessionAsync();
        await AuthState.RefreshAsync();

        if (session is null)
        {
            error = "El navegador no conservó la sesión. Revisa HTTPS y CORS.";
        }
    });

    private Task LogoutAsync() => ExecuteAsync(async () =>
    {
        using var response = await SendAsync(
            HttpMethod.Post, "api/auth/logout", new { });

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            response.EnsureSuccessStatusCode();
        }

        session = null;
        form.Password = string.Empty;
        await AuthState.RefreshAsync();
    });

    private async Task LoadSessionAsync()
    {
        using var response = await SendAsync(
            HttpMethod.Get, "api/auth/me");

        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            session = null;
            return;
        }

        response.EnsureSuccessStatusCode();

        session = await response.Content
            .ReadFromJsonAsync<SessionInfo>();
    }

    private async Task<HttpResponseMessage> SendAsync(
        HttpMethod method,
        string path,
        object? body = null)
    {
        var baseUrl = Configuration["ApiBaseUrl"]
            ?? throw new InvalidOperationException(
                "Falta configurar ApiBaseUrl.");

        using var request = new HttpRequestMessage(
            method, new Uri(new Uri(baseUrl), path));

        request.SetBrowserRequestCredentials(
            BrowserRequestCredentials.Include);

        if (body is not null)
        {
            request.Content = JsonContent.Create(body);
        }

        return await Http.SendAsync(request);
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        busy = true;
        error = null;

        try
        {
            await action();
        }
        catch (HttpRequestException)
        {
            error = "No se pudo completar la solicitud. " +
                    "Revisa la API, el certificado HTTPS y CORS.";
        }
        finally
        {
            busy = false;
        }
    }

    public class LoginInput
    {
        [Required(ErrorMessage = "Escribe tu correo.")]
        [EmailAddress(ErrorMessage = "Escribe un correo válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe tu contraseña.")]
        public string Password { get; set; } = string.Empty;
    }

    public class SessionInfo
    {
        public string Email { get; set; } = string.Empty;
        public string[] Roles { get; set; } = [];
    }
}
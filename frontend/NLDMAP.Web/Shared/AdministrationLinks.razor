@namespace NLDMAP.Web.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using NLDMAP.Web.Administration
@using NLDMAP.Web.Authentication
@inject CookieAuthStateProvider Auth

<AuthorizeView Policy="@AdminPermissions.UsersRead" Context="usersContext">
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/users">
                Usuarios
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Policy="@AdminPermissions.RolesRead" Context="rolesContext">
    <Authorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/roles">
                Roles y permisos
            </NavLink>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Context="sessionContext">
    <Authorized>
        <div class="nav-item px-3">
            <button type="button"
                    class="nav-link"
                    disabled="@busy"
                    @onclick="RefreshAsync">
                @(busy ? "Actualizando..." : "Actualizar acceso")
            </button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool busy;

    private async Task RefreshAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await Auth.RefreshAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
